@using E_Commerce.ViewModels.UserDashboard
@model UserOrderDetailsVM
@{
    ViewData["Title"] = "Order Details";
}

<div class="dashboard-page">
    <div class="container">
        <span class="dashboard-eyebrow">My Account</span>
        <h1 class="dashboard-heading">Order Details</h1>
        <hr style="border-color:var(--sand);margin:1.5rem 0 2.5rem;">

        <div class="dash-card mb-4">
            <div class="dash-card-head"><h4>Order Summary</h4></div>
            <div class="dash-card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="dash-info-label">Order ID</div>
                        <div class="dash-info-value">#@Model.OrderId</div>
                    </div>
                    <div class="col-md-4">
                        <div class="dash-info-label">Date</div>
                        <div class="dash-info-value">@Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                    </div>
                    <div class="col-md-4">
                        <div class="dash-info-label">Total</div>
                        <div class="dash-info-value" style="font-family:var(--ff-serif);font-size:1.2rem;">@Model.TotalPrice.ToString("0.00") LE</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="dash-card">
            <div class="dash-card-head"><h4>Order Items</h4></div>
            <div class="dash-card-body" style="padding:0;">
                @if (Model.Items != null && Model.Items.Any())
                {
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Image</th>
                                <th>Qty</th>
                                <th>Unit Price</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>
                                        <img src="@item.ProductImage"
                                             style="width:52px;height:52px;object-fit:cover;border-radius:4px;border:1px solid var(--sand);" />
                                    </td>
                                    <td>@item.Quantity</td>
                                    <td>@item.UnitPrice.ToString("0.00") LE</td>
                                    <td style="font-weight:500;">@item.SubTotal.ToString("0.00") LE</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="dash-alert-empty" style="margin:1.5rem;">No items in this order.</div>
                }
            </div>
        </div>

        <a asp-action="Orders" asp-controller="UserDashboard" class="btn-dash-outline mt-3 d-inline-block">
            &larr; Back to Orders
        </a>
    </div>
</div>
