@using E_Commerce.ViewModels.UserDashboard
@model UserOrderDetailsVM
@{
    ViewData["Title"] = "OrderDetails";
}

<div class="container mt-4">
    <h2 class="mb-4">Order Details</h2>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <p><strong>Order Id:</strong> @Model.OrderId</p>
            <p><strong>Date:</strong> @Model.OrderDate.ToString("dd/MM/yyyy hh:mm tt")</p>
            <p><strong>Total Price:</strong> @Model.TotalPrice.ToString("0.00")</p>
        </div>
    </div>

    @if (Model.Items != null && Model.Items.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header">
                <h4>Order Items</h4>
            </div>

            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Image</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Sub Total</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var Item in Model.Items)
                        {
                            <tr>
                                <td>@Item.ProductName</td>

                                <td>
                                    <img src="@Item.ProductImage"
                                         style="width:60px; height:60px; object-fit:cover;" />
                                </td>

                                <td>@Item.Quantity</td>

                                <td>@Item.UnitPrice.ToString("0.00")</td>

                                <td>@Item.SubTotal.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            No items in this order.
        </div>
    }

    <a asp-action="Orders" asp-controller="UserDashboard" class="btn btn-outline-dark mt-3">
        Back to Orders
    </a>
</div>

