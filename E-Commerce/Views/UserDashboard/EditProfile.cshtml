@using E_Commerce.ViewModels.UserDashboard
@model EditProfileVM
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="dashboard-page">
    <div class="container">
        <span class="dashboard-eyebrow">My Account</span>
        <h1 class="dashboard-heading">Edit Profile</h1>
        <hr style="border-color:var(--sand);margin:1.5rem 0 2.5rem;">

        <div class="dash-card">
            <div class="dash-card-body">
                <form asp-action="EditProfile" method="post" class="profile-form">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="text-danger mb-3" style="font-size:0.83rem;"></div>

                    <h5 class="profile-section-title">Personal Information</h5>
                    <div class="row g-3 mb-2">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FullName">Full Name</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email">Email</label>
                            <input asp-for="Email" class="form-control" readonly style="opacity:0.6;" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber">Phone Number</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                    </div>

                    <h5 class="profile-section-title">Address</h5>
                    <div class="row g-3 mb-2">
                        <div class="col-12 mb-3">
                            <label asp-for="Address">Street Address</label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="City">City</label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="PostalCode">Postal Code</label>
                            <input asp-for="PostalCode" class="form-control" />
                            <span asp-validation-for="PostalCode" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Country">Country</label>
                            <input asp-for="Country" class="form-control" />
                            <span asp-validation-for="Country" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                    </div>

                    <h5 class="profile-section-title">Change Password</h5>
                    <div class="row g-3">
                        <div class="col-md-4 mb-3">
                            <label asp-for="CurrentPassword">Current Password</label>
                            <input asp-for="CurrentPassword" class="form-control" autocomplete="off" />
                            <span asp-validation-for="CurrentPassword" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="NewPassword">New Password</label>
                            <input asp-for="NewPassword" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ConfirmPassword">Confirm New Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn-dash-primary">Save Changes</button>
                        <a asp-action="Index" asp-controller="UserDashboard" class="btn-dash-outline">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
