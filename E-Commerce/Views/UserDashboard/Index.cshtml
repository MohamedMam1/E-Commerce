@using E_Commerce.ViewModels.UserDashboard
@model UserDashboardVM
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="dashboard-page">
    <div class="container">
        <span class="dashboard-eyebrow">My Account</span>
        <h1 class="dashboard-heading">Dashboard</h1>
        <hr style="border-color:var(--sand);margin:1.5rem 0 2.5rem;">

        <!-- Account Info -->
        <div class="dash-card">
            <div class="dash-card-head">
                <h4>Account Information</h4>
                <a asp-action="EditProfile" asp-controller="UserDashboard" class="btn-dash-outline">Edit Profile</a>
            </div>
            <div class="dash-card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="dash-info-label">Full Name</div>
                        <div class="dash-info-value">@Model.FullName</div>
                    </div>
                    <div class="col-md-4">
                        <div class="dash-info-label">Email</div>
                        <div class="dash-info-value">@Model.Email</div>
                    </div>
                    <div class="col-md-4">
                        <div class="dash-info-label">Phone</div>
                        <div class="dash-info-value">@(Model.PhoneNumber ?? "—")</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Address))
                {
                    <div class="dash-address-box mt-3">
                        <div class="dash-info-label mb-1">Shipping Address</div>
                        <div style="font-size:0.88rem;color:var(--ink);">@Model.Address</div>
                        <div style="font-size:0.78rem;color:var(--stone);margin-top:2px;">@Model.City, @Model.PostalCode, @Model.Country</div>
                    </div>
                }
                else
                {
                    <div class="dash-alert-empty mt-3">No address saved yet.</div>
                }

                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Orders" asp-controller="UserDashboard" class="btn-dash-primary">View All Orders</a>
                </div>
            </div>
        </div>

        <!-- Recent Orders -->
        <div class="dash-card">
            <div class="dash-card-head">
                <h4>Recent Orders</h4>
                <a asp-action="Orders" asp-controller="UserDashboard" class="btn-dash-sm">See All</a>
            </div>
            <div class="dash-card-body" style="padding:0;">
                @if (Model.RecentOrders != null && Model.RecentOrders.Any())
                {
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Date</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>#@order.OrderId</td>
                                    <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                                    <td>@order.ItemsCount</td>
                                    <td>@order.TotalPrice.ToString("0.00") LE</td>
                                    <td>
                                        <a asp-action="OrderDetails" asp-controller="UserDashboard" asp-route-id="@order.OrderId" class="btn-dash-sm">Details</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="dash-alert-empty" style="margin:1.5rem;">No orders yet.</div>
                }
            </div>
        </div>
    </div>
</div>
