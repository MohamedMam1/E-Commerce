@using System.Security.Claims
@using E_Commerce.Interfaces
@inject ICartService CartService
@inject IWishlistService WishlistService

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var cartCount = 0;
    var wishlistCount = 0;

    if (!string.IsNullOrEmpty(userId))
    {
        cartCount = await CartService.GetCartItemCountAsync(userId);
        wishlistCount = await WishlistService.GetWishlistItemCountAsync(userId);
    }
}

<header>
	<!-- Header desktop -->
	<div class="container-menu-desktop">
		<!-- Topbar -->
		<div class="top-bar">
			<div class="content-topbar flex-sb-m h-full container">
			</div>
		</div>

		<div class="wrap-menu-desktop">
			<nav class="limiter-menu-desktop container">

				<!-- Logo desktop -->
				<a asp-controller="Home" asp-action="Index" class="logo">
					<img src="~/images/icons/logo-01.png" alt="IMG-LOGO">
				</a>

				<!-- Menu desktop -->
				<div class="menu-desktop">
					<ul class="main-menu">
					
						<li class="active-menu">
    <a asp-controller="Home" asp-action="Index">Home</a>
</li>
						

						<li>
							<a asp-controller="Product" asp-action="Index">Shop</a>
						</li>

						<li class="label1" data-label1="hot">
							<a asp-controller="Cart" asp-action="Index">Features</a>
						</li>

					<li>
    <a asp-controller="Home" asp-action="Blog">Blog</a>
</li>

<li>
    <a asp-controller="Home" asp-action="About">About</a>
</li>

<li>
    <a asp-controller="Home" asp-action="Contact">Contact</a>
</li>
					</ul>
				</div>

				<!-- Icon header -->
				<div class="wrap-icon-header flex-w flex-r-m">

					<!-- Search -->
					<div class="icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11 js-show-modal-search">
						<i class="zmdi zmdi-search"></i>
					</div>

					<!-- Cart -->
					<a id="cartIcon"
					   asp-controller="Cart" asp-action="Index"
					   class="dis-block icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11 icon-header-noti"
					   data-notify="@cartCount">
						<i class="zmdi zmdi-shopping-cart"></i>
					</a>

					<!-- Wishlist -->
					<a id="wishlistIcon"
					   asp-controller="Wishlist" asp-action="Index"
					   class="dis-block icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11 icon-header-noti"
					   data-notify="@wishlistCount">
						<i class="zmdi zmdi-favorite-outline"></i>
					</a>

					<!-- USER ICON -->
					@if (User.Identity.IsAuthenticated)
					{
						<div class="dropdown p-l-22 p-r-11">
							<a href="#" class="icon-header-item cl2 hov-cl1 trans-04 dropdown-toggle"
							   id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
								<i class="zmdi zmdi-account"></i>
							</a>

							<ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
								<li>
									<a class="dropdown-item" asp-controller="UserDashboard" asp-action="Index">
										Dashboard
									</a>
								</li>
								<li>
									<a class="dropdown-item" asp-controller="UserDashboard" asp-action="Orders">
										Orders
									</a>
								</li>
								<li>
									<a class="dropdown-item" asp-controller="Account" asp-action="SignOut">
										Logout
									</a>
								</li>
							</ul>
						</div>
					}
					else
					{
						<a asp-controller="Account" asp-action="Login"
						   class="dis-block icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11">
							<i class="zmdi zmdi-account"></i>
						</a>
					}

				</div>
			</nav>
		</div>
	</div>

	<!-- Header Mobile -->
	<div class="wrap-header-mobile">
		<!-- Logo moblie -->
		<div class="logo-mobile">
			<a asp-controller="Home" asp-action="Index"><img src="~/images/icons/logo-01.png" alt="IMG-LOGO"></a>
		</div>

		<!-- Icon header -->
		<div class="wrap-icon-header flex-w flex-r-m m-r-15">
			<div class="icon-header-item cl2 hov-cl1 trans-04 p-r-11 js-show-modal-search">
				<i class="zmdi zmdi-search"></i>
			</div>

			<a id="cartIconMobile"
			   asp-controller="Cart" asp-action="Index"
			   class="dis-block icon-header-item cl2 hov-cl1 trans-04 p-r-11 p-l-10 icon-header-noti"
			   data-notify="@cartCount">
				<i class="zmdi zmdi-shopping-cart"></i>
			</a>

			<a id="wishlistIconMobile"
			   asp-controller="Wishlist" asp-action="Index"
			   class="dis-block icon-header-item cl2 hov-cl1 trans-04 p-r-11 p-l-10 icon-header-noti"
			   data-notify="@wishlistCount">
				<i class="zmdi zmdi-favorite-outline"></i>
			</a>
		</div>

		<!-- Button show menu -->
		<div class="btn-show-menu-mobile hamburger hamburger--squeeze">
			<span class="hamburger-box">
				<span class="hamburger-inner"></span>
			</span>
		</div>
	</div>

	<!-- Menu Mobile -->
	<div class="menu-mobile">
		<ul class="topbar-mobile">
			<li>
				<div class="left-top-bar">
					Free shipping for standard order over $100
				</div>
			</li>

			<li>
				<div class="right-top-bar flex-w h-full">
					<a href="#" class="flex-c-m p-lr-10 trans-04">
						Help & FAQs
					</a>

					@if (User.Identity.IsAuthenticated)
					{
						<a asp-controller="UserDashboard" asp-action="Index" class="flex-c-m p-lr-10 trans-04">
							My Account
						</a>
					}
					else
					{
						<a asp-controller="Account" asp-action="Login" class="flex-c-m p-lr-10 trans-04">
							My Account
						</a>
					}

					<a href="#" class="flex-c-m p-lr-10 trans-04">
						EN
					</a>

					<a href="#" class="flex-c-m p-lr-10 trans-04">
						USD
					</a>
				</div>
			</li>
		</ul>

		<ul class="main-menu-m">
			<li>
				<a asp-controller="Home" asp-action="Index">Home</a>
				<ul class="sub-menu-m">
					<li><a asp-controller="Home" asp-action="Index">Homepage 1</a></li>
					<li><a asp-controller="Home" asp-action="Index">Homepage 2</a></li>
					<li><a asp-controller="Home" asp-action="Index">Homepage 3</a></li>
				</ul>
				<span class="arrow-main-menu-m">
					<i class="fa fa-angle-right" aria-hidden="true"></i>
				</span>
			</li>

			<li>
				<a asp-controller="Product" asp-action="Index">Shop</a>
			</li>

			<li>
				<a asp-controller="Cart" asp-action="Index" class="label1 rs1" data-label1="hot">Features</a>
			</li>

		     <li>
    <a asp-controller="Home" asp-action="Blog">Blog</a>
</li>

<li>
    <a asp-controller="Home" asp-action="About">About</a>
</li>

<li>
    <a asp-controller="Home" asp-action="Contact">Contact</a>
</li>
		</ul>
	</div>

	<!-- Modal Search -->
	<div class="modal-search-header flex-c-m trans-04 js-hide-modal-search">
		<div class="container-search-header">
			<button class="flex-c-m btn-hide-modal-search trans-04 js-hide-modal-search">
				<img src="~/images/icons/icon-close2.png" alt="CLOSE">
			</button>

			<form asp-controller="Product" asp-action="Search" method="get" class="wrap-search-header flex-w p-l-15">
				<button type="submit" class="flex-c-m trans-04">
					<i class="zmdi zmdi-search"></i>
				</button>
				<input class="plh3" type="text" name="SearchValue" placeholder="Search...">
			</form>
		</div>
	</div>
</header>