*@
@{
}

<footer class="vestra-footer">
	<div class="container">
		<div class="row g-5 pb-5">

			<!-- Brand Column -->
			<div class="col-lg-3 col-md-6">
				<span class="footer-brand">Vestra</span>
				<p class="footer-tagline">
					Curated fashion for the modern wardrobe. Quality you can feel, style you can trust.
				</p>
				<div class="footer-social">
					<a href="#" aria-label="Facebook"><i class="fa fa-facebook"></i></a>
					<a href="#" aria-label="Instagram"><i class="fa fa-instagram"></i></a>
					<a href="#" aria-label="Pinterest"><i class="fa fa-pinterest-p"></i></a>
				</div>
			</div>

			<!-- Categories -->
			<div class="col-lg-2 col-md-3 col-6">
				<span class="footer-heading">Categories</span>
				<ul>
					<li><a href="#">Women</a></li>
					<li><a href="#">Men</a></li>
					<li><a href="#">Shoes</a></li>
					<li><a href="#">Watches</a></li>
					<li><a href="#">Accessories</a></li>
				</ul>
			</div>

			<!-- Help -->
			<div class="col-lg-2 col-md-3 col-6">
				<span class="footer-heading">Help</span>
				<ul>
					<li><a href="#">Track Order</a></li>
					<li><a href="#">Returns</a></li>
					<li><a href="#">Shipping</a></li>
					<li><a href="#">FAQs</a></li>
					<li><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
				</ul>
			</div>

			<!-- Contact -->
			<div class="col-lg-2 col-md-6">
				<span class="footer-heading">Get In Touch</span>
				<p class="footer-contact-text">
					8th floor, 379 Hudson St,<br>
					New York, NY 10018<br>
					(+1) 96 716 6879
				</p>
			</div>

			<!-- Newsletter -->
	

		</div>

		<hr class="footer-divider" />

		<div class="footer-bottom">
			<p class="footer-copy mb-0">
				&copy; <script>document.write(new Date().getFullYear());</script> Vestra. All rights reserved.
				Template by <a href="https://colorlib.com" target="_blank">Colorlib</a>.
			</p>
			<div class="footer-pay-icons">
				<img src="/images/icons/icon-pay-01.png" alt="Payment">
				<img src="/images/icons/icon-pay-02.png" alt="Payment">
				<img src="/images/icons/icon-pay-03.png" alt="Payment">
				<img src="/images/icons/icon-pay-04.png" alt="Payment">
				<img src="/images/icons/icon-pay-05.png" alt="Payment">
			</div>
		</div>

	</div>
</footer>
