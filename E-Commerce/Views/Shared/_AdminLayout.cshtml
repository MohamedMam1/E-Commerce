@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html>
<head>
    <title>E_Commerce - @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="/css/admin.css" rel="stylesheet" />
</head>
<body>
    <header class="topbar">

        <div class="topbar-breadcrumb d-none d-md-flex">
            <i class="bi bi-house-fill" style="font-size:12px"></i>
            <i class="bi bi-chevron-right" style="font-size:10px"></i>
            <span class="current" id="breadcrumbCurrent">Dashboard</span>
        </div>

    @*     <div class="search-wrap">
            <i class="bi bi-search"></i>
            <input type="text" placeholder="Search products, orders…" id="globalSearch" />
        </div> 

        <div class="topbar-actions ms-2">
            <div class="topbar-btn" title="Notifications">
                <i class="bi bi-bell"></i>
                <span class="notif-dot"></span>
            </div> *@

            <!-- Profile dropdown -->
            <div class="dropdown ms-auto">
                <a class="topbar-profile dropdown-toggle" href="#" data-bs-toggle="dropdown" aria-expanded="false" style="text-decoration:none">
                    <div class="t-avatar">A</div>
                    <span class="t-name d-none d-sm-block">Admin</span>
                    <i class="bi bi-chevron-down"></i>
                </a>

                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-1" style="min-width:200px;font-size:13px">
                    <li><h6 class="dropdown-header fw-bold">Admin</h6></li>
                    <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2 text-primary"></i>Back to Home</a></li>
                    <li><hr class="dropdown-divider my-1"></li>
                    <li><a class="dropdown-item py-2 text-danger" href="/Account/SignOut"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                </ul>
            </div>
        </div>
    </header>
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <aside class="sidebar" id="sidebar">
        <a class="sidebar-brand" href="@Url.Action("AdminDashboard", "AdminDashboard")">
            <div class="brand-icon"><i class="bi bi-lightning-charge-fill"></i></div>
            <div>
                <div class="brand-name">VestraStore</div>
                <span class="brand-tag">VestraStore Platform</span>
            </div>
        </a>

        <!-- Main Navigation -->
        <div class="sidebar-section">Main</div>
        <ul class="sidebar-menu">
            <li>
                <a href="/admin"
                   class="@(currentAction == "Index" ? "active" : "")">
                    <i class="bi bi-grid-1x2-fill"></i> Dashboard
                </a>
            </li>

            <li>
                <a href="/admin/products"
                   class="@(currentAction == "Products" ? "active" : "")">
                    <i class="bi bi-box-seam-fill"></i> Products
                </a>
            </li>

            <li>
                <a href="/admin/categories"
                   class="@(currentAction == "Categories" ? "active" : "")">
                    <i class="bi bi-tags-fill"></i> Categories
                </a>
            </li>

            <li>
                <a href="/admin/orders"
                   class="@(currentAction == "Orders" ? "active" : "")">
                    <i class="bi bi-receipt-cutoff"></i> Orders
                </a>
            </li>

            <li>
                <a href="/admin/users"
                   class="@(currentAction == "Users" ? "active" : "")">
                    <i class="bi bi-people-fill"></i> Users
                </a>
            </li>
            <li>
                <a href="/admin/AccountSettings"
                   class="@(currentAction == "AccountSettings" ? "active" : "")">
                    <i class="bi bi-person-fill"></i> Account Settings
                </a>
            </li>
        </ul>
    </aside>



        <main class="page-content">
            @RenderBody()
        </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebarOverlay').classList.toggle('open');
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>