@{
}
@model E_Commerce.ViewModels.Product.ProductEditVM

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="main-wrapper">

<div class="container-fluid py-4">

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">

            <h4 class="mb-4 fw-bold">Edit Product</h4>

            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Basic Info -->
                <div class="row g-3">

                    <!-- Name -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Name" class="form-control" placeholder="Product Name" />
                            <label>Product Name</label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                                <option value="">Select Category</option>
                            </select>
                            <label>Category</label>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Price -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Price" class="form-control" placeholder="Price" />
                            <label>Price</label>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <div class="form-floating">
                            <textarea asp-for="Description" class="form-control"
                                      placeholder="Description"
                                      style="height:120px"></textarea>
                            <label>Description</label>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Variants Section -->
                    <div class="col-12">
                        <h5 class="mt-4 mb-3">Product Variants</h5>
                        <div id="variants-container">
                            @if (Model.Variants != null && Model.Variants.Any())
                            {
                                @for (int i = 0; i < Model.Variants.Count; i++)
                                {
                                    <div class="variant-row mb-3 p-3 border rounded bg-light">
                                        <div class="row">
                                            <div class="col-md-4 mb-2">
                                                <label class="form-label">Size</label>
                                                <input type="text" name="Variants[@i].Size" class="form-control" value="@Model.Variants[i].Size" placeholder="e.g., S, M, L, XL" />
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <label class="form-label">Color</label>
                                                <input type="text" name="Variants[@i].Color" class="form-control" value="@Model.Variants[i].Color" placeholder="e.g., Red, Blue" />
                                            </div>
                                            <div class="col-md-3 mb-2">
                                                <label class="form-label">Stock</label>
                                                <input type="number" name="Variants[@i].Stock" class="form-control" value="@Model.Variants[i].Stock" min="0" />
                                            </div>
                                            <div class="col-md-1 mb-2 d-flex align-items-end">
                                                <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariant(this)">Remove</button>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="alert alert-info">No variants added yet.</div>
                            }
                        </div>
                        <button type="button" class="btn btn-secondary mt-2" onclick="addVariant()">+ Add Variant</button>
                    </div>



                </div>

                <hr class="my-4" />

                <!-- Images -->
                <div class="row g-4">

                    <!-- Main Image -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Main Image</label>

                        @if (!string.IsNullOrEmpty(Model.ExistingMainImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.ExistingMainImageUrl"
                                     class="rounded border"
                                     style="width:120px;height:120px;object-fit:cover;" />
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small">No main image</p>
                        }

                        <input asp-for="MainImage" type="file" class="form-control"
                               accept="image/*"
                               onchange="previewImage(this, 'mainPreview')" />

                        <img id="mainPreview" class="mt-2 rounded d-none border"
                             style="width:120px;height:120px;object-fit:cover;" />
                    </div>

                    <!-- Extra Images -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Extra Images</label>

                        <div class="d-flex flex-wrap gap-2 mb-2">
                            @if (Model.ExistingExtraImageUrls != null && Model.ExistingExtraImageUrls.Any())
                            {
                                foreach (var img in Model.ExistingExtraImageUrls)
                                {
                                    <img src="@img"
                                         class="rounded border"
                                         style="width:70px;height:70px;object-fit:cover;" />
                                }
                            }
                            else
                            {
                                <p class="text-muted small">No extra images</p>
                            }
                        </div>

                        <!-- Upload new -->
                        <div class="mb-2">
                            <input asp-for="ExtraImage1" type="file" class="form-control"
                                   accept="image/*"
                                   onchange="previewImage(this, 'extraPreview1')" />
                            <img id="extraPreview1" class="mt-1 rounded d-none border"
                                 style="width:70px;height:70px;object-fit:cover;" />
                        </div>

                        <div class="mb-2">
                            <input asp-for="ExtraImage2" type="file" class="form-control"
                                   accept="image/*"
                                   onchange="previewImage(this, 'extraPreview2')" />
                            <img id="extraPreview2" class="mt-1 rounded d-none border"
                                 style="width:70px;height:70px;object-fit:cover;" />
                        </div>

                        <div class="mb-2">
                            <input asp-for="ExtraImage3" type="file" class="form-control"
                                   accept="image/*"
                                   onchange="previewImage(this, 'extraPreview3')" />
                            <img id="extraPreview3" class="mt-1 rounded d-none border"
                                 style="width:70px;height:70px;object-fit:cover;" />
                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <!-- Buttons -->
                <div class="d-flex justify-content-end gap-2">
                        <a asp-action="products" asp-controller="Admin" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">
                        Update Product
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let variantIndex = @(Model.Variants?.Count ?? 0);

        function previewImage(input, previewId) {
            const preview = document.getElementById(previewId);

            if (input.files && input.files[0]) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                };

                reader.readAsDataURL(input.files[0]);
            } else {
                preview.classList.add('d-none');
            }
        }

        function addVariant() {
            const container = document.getElementById('variants-container');
            const newVariant = document.createElement('div');
            newVariant.className = 'variant-row mb-3 p-3 border rounded bg-light';
            newVariant.innerHTML = `
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Size</label>
                        <input type="text" name="Variants[${variantIndex}].Size" class="form-control" placeholder="e.g., S, M, L, XL" />
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Color</label>
                        <input type="text" name="Variants[${variantIndex}].Color" class="form-control" placeholder="e.g., Red, Blue" />
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="form-label">Stock</label>
                        <input type="number" name="Variants[${variantIndex}].Stock" class="form-control" min="0" />
                    </div>
                    <div class="col-md-1 mb-2 d-flex align-items-end">
                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariant(this)">Remove</button>
                    </div>
                </div>
            `;
            container.appendChild(newVariant);
            variantIndex++;
        }

        function removeVariant(button) {
            button.closest('.variant-row').remove();
        }
    </script>

}