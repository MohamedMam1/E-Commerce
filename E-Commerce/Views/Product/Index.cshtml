@using E_Commerce.ViewModels.Product
@using E_Commerce.ViewModels.AdminDashboard
@{
    ViewData["Title"] = "Products";
}
@model PaginatedResultVM<ProductListVM>

<section class="shop-page">
    <div class="shop-container">

        <div class="shop-topbar">
            <div class="shop-cats" id="cat-group">
                <button class="cat-btn active" data-cat="">All</button>
                @foreach (var cat in ViewBag.Categories)
                {
                    <button class="cat-btn" data-cat="@cat.Name">@cat.Name</button>
                }
            </div>
            <div class="shop-controls">
                <button class="ctrl-btn" id="btn-toggle-search">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    Search
                </button>
                <button class="ctrl-btn" id="btn-toggle-filter">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
                    Filter
                </button>
            </div>
        </div>

        <div class="shop-search-panel" id="search-panel">
            <div class="search-inner">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                <input type="text" id="search-input" placeholder="Search products…" autocomplete="off" />
            </div>
        </div>

        <div class="shop-filter-panel" id="filter-panel">
            <div class="filter-group">
                <p class="filter-label">Sort by</p>
                <ul class="filter-list">
                    <li><a href="#" class="fl-link active js-sort" data-sort="">Default</a></li>
                    <li><a href="#" class="fl-link js-sort" data-sort="price_asc">Price: low to high</a></li>
                    <li><a href="#" class="fl-link js-sort" data-sort="price_desc">Price: high to low</a></li>
                </ul>
            </div>
            <div class="filter-group">
                <p class="filter-label">Price</p>
                <ul class="filter-list">
                    <li><a href="#" class="fl-link active js-price" data-min="" data-max="">All</a></li>
                    <li><a href="#" class="fl-link js-price" data-min="0" data-max="300">0 – 300 LE</a></li>
                    <li><a href="#" class="fl-link js-price" data-min="300" data-max="500">300 – 500 LE</a></li>
                    <li><a href="#" class="fl-link js-price" data-min="500" data-max="800">500 – 800 LE</a></li>
                    <li><a href="#" class="fl-link js-price" data-min="800" data-max="1000">800 – 1000 LE</a></li>
                    <li><a href="#" class="fl-link js-price" data-min="1000" data-max="">1000 LE +</a></li>
                </ul>
            </div>
            <div class="filter-group">
                <p class="filter-label">Availability</p>
                <ul class="filter-list">
                    <li><a href="#" class="fl-link active js-avail" data-avail="">All</a></li>
                    <li><a href="#" class="fl-link js-avail" data-avail="true">In stock</a></li>
                    <li><a href="#" class="fl-link js-avail" data-avail="false">Out of stock</a></li>
                </ul>
            </div>
        </div>

        <div class="shop-meta">
            <span class="meta-count" id="results-count">
                @Model.TotalCount product@(Model.TotalCount != 1 ? "s" : "") found
            </span>
        </div>

        <div class="product-grid" id="product-grid">
            @foreach (var item in Model.Data)
            {
                <div class="product-card">
                    <div class="card-img-wrap">
                        <img src="@item.ImageUrl" alt="@item.Name" loading="lazy"
                             style="opacity:0;transition:opacity .3s ease;"
                             onload="this.style.opacity='1'" />
                        <a asp-controller="ProductDetail" asp-action="Index" asp-route-id="@item.Id" class="card-overlay-btn">View Details</a>
                    </div>
                    <div class="card-info">
                        <a asp-controller="ProductDetail" asp-action="Index" asp-route-id="@item.Id" class="card-name">@item.Name</a>
                        <span class="card-price">@item.Price.ToString("F2") LE</span>
                    </div>
                </div>
            }
        </div>

        <div class="shop-spinner" id="loading-spinner" style="display:none;"><div class="spinner-ring"></div></div>
        <div class="shop-empty" id="no-results" style="display:none;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <p>No products found</p>
        </div>

        <div class="shop-pagination" id="pagination-container"></div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const state = { search:'', categoryName:'', sort:'', minPrice:'', maxPrice:'', isAvailable:'', page:1, pageSize:12 };
            let debounceTimer = null;
            const grid = document.getElementById('product-grid');
            const spinner = document.getElementById('loading-spinner');
            const noResults = document.getElementById('no-results');
            const pagination = document.getElementById('pagination-container');
            const countLabel = document.getElementById('results-count');
            const searchInput = document.getElementById('search-input');

            document.getElementById('btn-toggle-search').addEventListener('click', function () {
                const panel = document.getElementById('search-panel');
                const open = panel.classList.toggle('visible');
                this.classList.toggle('open', open);
                document.getElementById('filter-panel').classList.remove('visible');
                document.getElementById('btn-toggle-filter').classList.remove('open');
                if (open) searchInput.focus();
            });

            document.getElementById('btn-toggle-filter').addEventListener('click', function () {
                const panel = document.getElementById('filter-panel');
                const open = panel.classList.toggle('visible');
                this.classList.toggle('open', open);
                document.getElementById('search-panel').classList.remove('visible');
                document.getElementById('btn-toggle-search').classList.remove('open');
            });

            function fetchProducts() {
                spinner.style.display = 'flex'; grid.style.opacity = '0.4'; noResults.style.display = 'none';
                const params = new URLSearchParams();
                if (state.search) params.set('searchTerm', state.search);
                if (state.categoryName) params.set('categoryName', state.categoryName);
                if (state.minPrice !== '') params.set('minPrice', state.minPrice);
                if (state.maxPrice !== '') params.set('maxPrice', state.maxPrice);
                if (state.isAvailable !== '') params.set('isAvailable', state.isAvailable);
                if (state.sort) params.set('sortBy', state.sort);
                params.set('pageNumber', state.page); params.set('pageSize', state.pageSize);
                fetch('/Product/GetFilteredProducts?' + params.toString()).then(r => r.json()).then(data => {
                    renderGrid(data.products); renderPagination(data.totalPages, data.pageNumber, data.totalCount);
                    spinner.style.display = 'none'; grid.style.opacity = '1';
                }).catch(() => { spinner.style.display = 'none'; grid.style.opacity = '1'; });
            }

            function renderGrid(products) {
                if (!products || !products.length) { grid.innerHTML = ''; noResults.style.display = 'flex'; return; }
                noResults.style.display = 'none';
                grid.innerHTML = products.map(p => `<div class="product-card"><div class="card-img-wrap"><img src="${esc(p.imageUrl)}" alt="${esc(p.name)}" loading="lazy" style="display:block;width:100%;"><a href="/ProductDetail/Index/${p.id}" class="card-overlay-btn">View Details</a></div><div class="card-info"><a href="/ProductDetail/Index/${p.id}" class="card-name">${esc(p.name)}</a><span class="card-price">${p.price.toFixed(2)} LE</span></div></div>`).join('');
            }

            function renderPagination(totalPages, current, totalCount) {
                countLabel.textContent = totalCount + ' product' + (totalCount !== 1 ? 's' : '') + ' found';
                pagination.innerHTML = '';
                if (totalPages <= 1) return;
                const make = (label, page, cls) => { const btn = document.createElement('button'); btn.className = 'pg-btn' + (cls ? ' ' + cls : ''); btn.textContent = label; if (!cls || cls === 'active') btn.addEventListener('click', () => { state.page = page; window.scrollTo({top:0,behavior:'smooth'}); fetchProducts(); }); return btn; };
                const ellipsis = () => { const s = document.createElement('span'); s.className = 'pg-ellipsis'; s.textContent = '…'; return s; };
                pagination.appendChild(make('‹', current - 1, current === 1 ? 'disabled' : ''));
                buildRange(current, totalPages).forEach(p => { if (p === '...') { pagination.appendChild(ellipsis()); return; } pagination.appendChild(make(p, p, p === current ? 'active' : '')); });
                pagination.appendChild(make('›', current + 1, current === totalPages ? 'disabled' : ''));
            }

            function buildRange(cur, total) {
                if (total <= 7) return Array.from({length:total},(_,i)=>i+1);
                if (cur <= 4) return [1,2,3,4,5,'...',total];
                if (cur >= total - 3) return [1,'...',total-4,total-3,total-2,total-1,total];
                return [1,'...',cur-1,cur,cur+1,'...',total];
            }

            function esc(str) { return (str||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
            function setActive(selector, el) { document.querySelectorAll(selector).forEach(e=>e.classList.remove('active')); el.classList.add('active'); }
            function resetPage() { state.page = 1; }

            renderPagination(@Model.TotalPages, @Model.PageNumber, @Model.TotalCount);

            document.querySelectorAll('.cat-btn').forEach(btn => btn.addEventListener('click', () => { setActive('.cat-btn', btn); state.categoryName = btn.dataset.cat; state.search = ''; searchInput.value = ''; resetPage(); fetchProducts(); }));
            searchInput.addEventListener('input', () => { clearTimeout(debounceTimer); debounceTimer = setTimeout(() => { state.search = searchInput.value.trim(); state.categoryName = ''; setActive('.cat-btn', document.querySelector('.cat-btn[data-cat=""]')); resetPage(); fetchProducts(); }, 400); });
            document.querySelectorAll('.js-sort').forEach(link => link.addEventListener('click', e => { e.preventDefault(); setActive('.js-sort',link); state.sort=link.dataset.sort; resetPage(); fetchProducts(); }));
            document.querySelectorAll('.js-price').forEach(link => link.addEventListener('click', e => { e.preventDefault(); setActive('.js-price',link); state.minPrice=link.dataset.min; state.maxPrice=link.dataset.max; resetPage(); fetchProducts(); }));
            document.querySelectorAll('.js-avail').forEach(link => link.addEventListener('click', e => { e.preventDefault(); setActive('.js-avail',link); state.isAvailable=link.dataset.avail; resetPage(); fetchProducts(); }));
        })();
    </script>
}
