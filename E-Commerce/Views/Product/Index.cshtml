@using E_Commerce.ViewModels.Product
@using E_Commerce.ViewModels.AdminDashboard
@{
    ViewData["Title"] = "Product";
}
@model PaginatedResultVM<ProductListVM>
<!-- Product -->

<section class="shop-page">
    <div class="shop-container">

        @* ── Top bar: category tabs + controls ── *@
        <div class="shop-topbar">
            <div class="shop-cats" id="cat-group">
                <button class="cat-btn active" data-cat="">All</button>
                <button class="cat-btn" data-cat="women">Women</button>
                <button class="cat-btn" data-cat="men">Men</button>
                <button class="cat-btn" data-cat="bag">Bag</button>
                <button class="cat-btn" data-cat="shoes">Shoes</button>
                <button class="cat-btn" data-cat="watches">Watches</button>
            </div>
            <div class="shop-controls">
                <button class="ctrl-btn" id="btn-toggle-search">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    Search
                </button>
                <button class="ctrl-btn" id="btn-toggle-filter">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6" /><line x1="8" y1="12" x2="16" y2="12" /><line x1="11" y1="18" x2="13" y2="18" /></svg>
                    Filter
                </button>
            </div>
        </div>

        @* ── Search panel ── *@
        <div class="shop-search-panel" id="search-panel">
            <div class="search-inner">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="text" id="search-input" placeholder="Search products…" autocomplete="off" />
            </div>
        </div>

        @* ── Filter panel ── *@
        <div class="shop-filter-panel" id="filter-panel">
            <div class="filter-group">
                <p class="filter-label">Sort by</p>
                <ul class="filter-list">
                    <li><a href="#" class="fl-link active js-sort" data-sort="">Default</a></li>
                    <li><a href="#" class="fl-link js-sort" data-sort="price_asc">Price: low to high</a></li>
                    <li><a href="#" class="fl-link js-sort" data-sort="price_desc">Price: high to low</a></li>
                </ul>
            </div>
            <div class="filter-group">
                <p class="filter-label">Price</p>
                <ul class="filter-list">
                    <li><a href="#" class="fl-link active js-price" data-min="" data-max="">All</a></li>
                    <li><a href="#" class="fl-link js-price" data-min="0" data-max="300">0 – 300 LE</a></li>
                    <li><a href="#" class="fl-link js-price" data-min="300" data-max="500">300 – 500 LE</a></li>
                    <li><a href="#" class="fl-link js-price" data-min="500" data-max="800">500 – 800 LE</a></li>
                    <li><a href="#" class="fl-link js-price" data-min="800" data-max="1000">800 – 1000 LE</a></li>
                    <li><a href="#" class="fl-link js-price" data-min="1000" data-max="">1000 LE +</a></li>
                </ul>
            </div>
            <div class="filter-group">
                <p class="filter-label">Availability</p>
                <ul class="filter-list">
                    <li><a href="#" class="fl-link active js-avail" data-avail="">All</a></li>
                    <li><a href="#" class="fl-link js-avail" data-avail="true">In stock</a></li>
                    <li><a href="#" class="fl-link js-avail" data-avail="false">Out of stock</a></li>
                </ul>
            </div>
        </div>

        @* ── Meta row ── *@
        <div class="shop-meta">
            <span class="meta-count" id="results-count">
                @Model.TotalCount product@(Model.TotalCount != 1 ? "s" : "") found
            </span>
        </div>

        @* ── Product grid ── *@

        <div class="product-grid" id="product-grid">
            @foreach (var item in Model.Data)
            {
                <div class="product-card">
                    <div class="card-img-wrap">
                        <img src="~/images/@item.ImageUrl" alt="@item.Name" loading="lazy">
                        <a asp-controller="ProductDetail" asp-action="Index" asp-route-id="@item.Id" class="card-overlay-btn">
                            View Details
                        </a>
                    </div>
                    <div class="card-info">
                        <a asp-controller="ProductDetail" asp-action="Index" asp-route-id="@item.Id" class="card-name">
                            @item.Name
                        </a>
                        <span class="card-price">@item.Price.ToString("F2") LE</span>
                    </div>
                </div>
            }
        </div>

        <div class="shop-spinner" id="loading-spinner" style="display:none;">
            <div class="spinner-ring"></div>
        </div>

        <div class="shop-empty" id="no-results" style="display:none;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ccc" stroke-width="1.5"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
            <p>No products found</p>
        </div>

        <div class="shop-pagination" id="pagination-container"></div>

    </div>
</section>

<style>
    .shop-page {
        padding: 48px 0 96px;
        background: #fafafa;
    }

    .shop-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .shop-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .shop-cats {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .cat-btn {
        padding: 8px 20px;
        font-size: 13px;
        font-family: inherit;
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 24px;
        cursor: pointer;
        color: #555;
        transition: all .2s;
    }

        .cat-btn:hover {
            border-color: #222;
            color: #222;
        }

        .cat-btn.active {
            background: #222;
            color: #fff;
            border-color: #222;
        }

    .shop-controls {
        display: flex;
        gap: 8px;
    }

    .ctrl-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 16px;
        font-size: 13px;
        font-family: inherit;
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        cursor: pointer;
        color: #555;
        transition: all .2s;
    }

        .ctrl-btn:hover {
            background: #f5f5f5;
            border-color: #bbb;
        }

        .ctrl-btn.open {
            background: #222;
            color: #fff;
            border-color: #222;
        }

    .shop-search-panel {
        display: none;
        margin-bottom: 16px;
    }

        .shop-search-panel.visible {
            display: block;
        }

    .search-inner {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 0 16px;
    }

        .search-inner svg {
            flex-shrink: 0;
            color: #aaa;
        }

        .search-inner input {
            flex: 1;
            border: none;
            outline: none;
            font-size: 14px;
            font-family: inherit;
            padding: 12px 0;
            background: transparent;
            color: #222;
        }

            .search-inner input::placeholder {
                color: #bbb;
            }

    .shop-filter-panel {
        display: none;
        background: #fff;
        border: 1px solid #eee;
        border-radius: 12px;
        padding: 25px 30px;
        margin-bottom: 25px;
        width: 100%;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

        .shop-filter-panel.visible {
            display: flex !important;
            flex-wrap: wrap;
            gap: 30px;
        }

    .filter-group {
        min-width: 180px;
    }

    .filter-label {
        font-size: 16px;
        font-weight: 600;
        color: #222;
        margin-bottom: 12px;
    }

    .filter-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .filter-list li {
            margin-bottom: 8px;
        }

    .fl-link {
        font-size: 14px;
        color: #777;
        text-decoration: none;
        padding: 4px 0;
        display: inline-block;
        transition: all 0.25s ease;
        position: relative;
    }

        .fl-link:hover {
            color: #111;
            transform: translateX(3px);
        }

        .fl-link.active {
            color: #6a7dfe;
            font-weight: 500;
        }

        .fl-link::after {
            content: "";
            position: absolute;
            left: 0;
            bottom: -2px;
            width: 0%;
            height: 2px;
            background: #6a7dfe;
            transition: width 0.3s;
        }

        .fl-link:hover::after,
        .fl-link.active::after {
            width: 100%;
        }

    .shop-meta {
        margin-bottom: 24px;
    }

    .meta-count {
        font-size: 13px;
        color: #999;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
    }

    .product-card {
        background: #fff;
        border-radius: 10px;
        border: 1px solid #efefef;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: border-color .2s;
    }

        .product-card:hover {
            border-color: #d0d0d0;
        }

    .card-img-wrap {
        position: relative;
        aspect-ratio: 3/4;
        overflow: hidden;
        background: #f5f5f5;
    }

        .card-img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform .35s ease;
        }

    .product-card:hover .card-img-wrap img {
        transform: scale(1.04);
    }

    .card-overlay-btn {
        position: absolute;
        bottom: 12px;
        left: 50%;
        transform: translateX(-50%) translateY(8px);
        white-space: nowrap;
        background: #fff;
        color: #222;
        font-size: 12px;
        font-family: inherit;
        padding: 8px 20px;
        border-radius: 24px;
        border: 1px solid #e0e0e0;
        text-decoration: none;
        opacity: 0;
        transition: opacity .2s, transform .2s;
    }

    .product-card:hover .card-overlay-btn {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
    }

    .card-info {
        padding: 14px 16px;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .card-name {
        font-size: 13px;
        color: #222;
        text-decoration: none;
        font-weight: 500;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

        .card-name:hover {
            color: #666;
        }

    .card-price {
        font-size: 13px;
        color: #888;
    }

    .shop-spinner {
        display: flex;
        justify-content: center;
        padding: 48px 0;
    }

    .spinner-ring {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 2px solid #ebebeb;
        border-top-color: #222;
        animation: spin .7s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .shop-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        padding: 80px 0;
        color: #bbb;
        font-size: 14px;
    }

    .shop-pagination {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 6px;
        padding: 40px 0 0;
    }

    .pg-btn {
        width: 36px;
        height: 36px;
        border-radius: 6px;
        border: 1px solid #e0e0e0;
        background: #fff;
        font-size: 13px;
        font-family: inherit;
        color: #555;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all .18s;
    }

        .pg-btn:hover {
            background: #f5f5f5;
            border-color: #bbb;
        }

        .pg-btn.active {
            background: #222;
            color: #fff;
            border-color: #222;
        }

        .pg-btn.disabled {
            opacity: .35;
            pointer-events: none;
        }

    .pg-ellipsis {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        color: #bbb;
    }
</style>

@section Scripts {
    <script>
        (function () {

            const state = {
                search:       '',
                categoryName: '',
                sort:         '',
                minPrice:     '',
                maxPrice:     '',
                isAvailable:  '',
                page:         1,
                pageSize:     12
            };

            let debounceTimer = null;

            const grid        = document.getElementById('product-grid');
            const spinner     = document.getElementById('loading-spinner');
            const noResults   = document.getElementById('no-results');
            const pagination  = document.getElementById('pagination-container');
            const countLabel  = document.getElementById('results-count');
            const searchInput = document.getElementById('search-input');

            document.getElementById('btn-toggle-search').addEventListener('click', function () {
                const panel = document.getElementById('search-panel');
                const open  = panel.classList.toggle('visible');
                this.classList.toggle('open', open);
                document.getElementById('filter-panel').classList.remove('visible');
                document.getElementById('btn-toggle-filter').classList.remove('open');
                if (open) searchInput.focus();
            });

            document.getElementById('btn-toggle-filter').addEventListener('click', function () {
                const panel = document.getElementById('filter-panel');
                const open  = panel.classList.toggle('visible');
                this.classList.toggle('open', open);
                document.getElementById('search-panel').classList.remove('visible');
                document.getElementById('btn-toggle-search').classList.remove('open');
            });

            function fetchProducts() {
                spinner.style.display   = 'flex';
                grid.style.opacity      = '0.4';
                noResults.style.display = 'none';

                const params = new URLSearchParams();
                if (state.search)             params.set('searchTerm',   state.search);
                if (state.categoryName)       params.set('categoryName', state.categoryName);
                if (state.minPrice !== '')     params.set('minPrice',     state.minPrice);
                if (state.maxPrice !== '')     params.set('maxPrice',     state.maxPrice);
                if (state.isAvailable !== '')  params.set('isAvailable',  state.isAvailable);
                if (state.sort)               params.set('sortBy',        state.sort);
                params.set('pageNumber', state.page);
                params.set('pageSize',   state.pageSize);

                fetch('/Product/GetFilteredProducts?' + params.toString())
                    .then(r => r.json())
                    .then(data => {
                        renderGrid(data.products);
                        renderPagination(data.totalPages, data.pageNumber, data.totalCount);
                        spinner.style.display = 'none';
                        grid.style.opacity    = '1';
                    })
                    .catch(() => {
                        spinner.style.display = 'none';
                        grid.style.opacity    = '1';
                    });
            }

            function renderGrid(products) {
                if (!products || products.length === 0) {
                    grid.innerHTML = '';
                    noResults.style.display = 'flex';
                    return;
                }
                noResults.style.display = 'none';
                grid.innerHTML = products.map(p => `
                    <div class="product-card">
                        <div class="card-img-wrap">
                            <img src="${esc(p.imageUrl)}" alt="${esc(p.name)}" loading="lazy" />
                            <a href="/ProductDetail/Index/${p.id}" class="card-overlay-btn">View Details</a>
                        </div>
                        <div class="card-info">
                            <a href="/ProductDetail/Index/${p.id}" class="card-name">${esc(p.name)}</a>
                            <span class="card-price">${p.price.toFixed(2)} LE</span>
                        </div>
                    </div>
                `).join('');
            }

            function renderPagination(totalPages, current, totalCount) {
                countLabel.textContent = totalCount + ' product' + (totalCount !== 1 ? 's' : '') + ' found';
                pagination.innerHTML   = '';
                if (totalPages <= 1) return;

                const make = (label, page, cls) => {
                    const btn = document.createElement('button');
                    btn.className   = 'pg-btn' + (cls ? ' ' + cls : '');
                    btn.textContent = label;
                    if (!cls || cls === 'active') {
                        btn.addEventListener('click', () => {
                            state.page = page;
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                            fetchProducts();
                        });
                    }
                    return btn;
                };

                const ellipsis = () => {
                    const s = document.createElement('span');
                    s.className   = 'pg-ellipsis';
                    s.textContent = '…';
                    return s;
                };

                pagination.appendChild(make('‹', current - 1, current === 1 ? 'disabled' : ''));

                buildRange(current, totalPages).forEach(p => {
                    if (p === '...') { pagination.appendChild(ellipsis()); return; }
                    pagination.appendChild(make(p, p, p === current ? 'active' : ''));
                });

                pagination.appendChild(make('›', current + 1, current === totalPages ? 'disabled' : ''));
            }

            function buildRange(cur, total) {
                if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
                if (cur <= 4)          return [1, 2, 3, 4, 5, '...', total];
                if (cur >= total - 3)  return [1, '...', total-4, total-3, total-2, total-1, total];
                return [1, '...', cur - 1, cur, cur + 1, '...', total];
            }

            function esc(str) {
                return (str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;')
                                  .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
            }

            function setActive(selector, el) {
                document.querySelectorAll(selector).forEach(e => e.classList.remove('active'));
                el.classList.add('active');
            }

            function resetPage() { state.page = 1; }
            renderPagination(@Model.TotalPages, @Model.PageNumber, @Model.TotalCount);

            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    setActive('.cat-btn', btn);
                    state.categoryName = btn.dataset.cat;
                    state.search       = '';
                    searchInput.value  = '';
                    resetPage();
                    fetchProducts();
                });
            });

            searchInput.addEventListener('input', () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    state.search       = searchInput.value.trim();
                    state.categoryName = '';
                    setActive('.cat-btn', document.querySelector('.cat-btn[data-cat=""]'));
                    resetPage();
                    fetchProducts();
                }, 400);
            });

            document.querySelectorAll('.js-sort').forEach(link => {
                link.addEventListener('click', e => {
                    e.preventDefault();
                    setActive('.js-sort', link);
                    state.sort = link.dataset.sort;
                    resetPage(); fetchProducts();
                });
            });

            document.querySelectorAll('.js-price').forEach(link => {
                link.addEventListener('click', e => {
                    e.preventDefault();
                    setActive('.js-price', link);
                    state.minPrice = link.dataset.min;
                    state.maxPrice = link.dataset.max;
                    resetPage(); fetchProducts();
                });
            });

            document.querySelectorAll('.js-avail').forEach(link => {
                link.addEventListener('click', e => {
                    e.preventDefault();
                    setActive('.js-avail', link);
                    state.isAvailable = link.dataset.avail;
                    resetPage(); fetchProducts();
                });
            });

        })();
    </script>
}
