@{
	ViewData["Title"] = "Product";
}
@model IEnumerable<ProductListVM>
<!-- Product -->
<div class="bg0 m-t-23 p-b-140">
	<div class="container">
		<div class="flex-w flex-sb-m p-b-52">
			<div class="flex-w flex-l-m filter-tope-group m-tb-10">
				<button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5 how-active1" data-filter="*">
					All Products
				</button>

				<button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".women">
					Women
				</button>

				<button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".men">
					Men
				</button>

				<button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".bag">
					Bag
				</button>

				<button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".shoes">
					Shoes
				</button>

				<button class="stext-106 cl6 hov1 bor3 trans-04 m-r-32 m-tb-5" data-filter=".watches">
					Watches
				</button>
			</div>

			<div class="flex-w flex-c-m m-tb-10">
				<div class="flex-c-m stext-106 cl6 size-104 bor4 pointer hov-btn3 trans-04 m-r-8 m-tb-4 js-show-filter">
					<i class="icon-filter cl2 m-r-6 fs-15 trans-04 zmdi zmdi-filter-list"></i>
					<i class="icon-close-filter cl2 m-r-6 fs-15 trans-04 zmdi zmdi-close dis-none"></i>
					Filter
				</div>

				<div class="flex-c-m stext-106 cl6 size-105 bor4 pointer hov-btn3 trans-04 m-tb-4 js-show-search">
					<i class="icon-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-search"></i>
					<i class="icon-close-search cl2 m-r-6 fs-15 trans-04 zmdi zmdi-close dis-none"></i>
					Search
				</div>
			</div>

			<!-- Search product -->
			<div class="dis-none panel-search w-full p-t-10 p-b-15">
				<form asp-controller="Product" asp-action="Search" method="get" class="bor8 dis-flex p-l-15">
					<button type="submit" class="size-113 flex-c-m fs-16 cl2 hov-cl1 trans-04">
						<i class="zmdi zmdi-search"></i>
					</button>
					<input class="mtext-107 cl2 size-114 plh2 p-r-15"
						   type="text"
						   name="SearchValue"
						   placeholder="Search products..."
						   value="@Context.Request.Query["SearchValue"]">
				</form>
			</div>

			<!-- Filter -->
			<div class="dis-none panel-filter w-full p-t-10">
				<div class="wrap-filter flex-w bg6 w-full p-lr-40 p-t-27 p-lr-15-sm">
					<div class="filter-col1 p-r-15 p-b-27">
						<div class="mtext-102 cl2 p-b-15">
							Sort By
						</div>

						<ul>
							<li class="p-b-6">
								<a asp-controller="Product" asp-action="Index" class="filter-link stext-106 trans-04">
									Default
								</a>
							</li>

							<li class="p-b-6">
								<a asp-controller="Product" asp-action="Filter" asp-route-SortBy="price_asc" class="filter-link stext-106 trans-04">
									Price: Low to High
								</a>
							</li>

							<li class="p-b-6">
								<a asp-controller="Product" asp-action="Filter" asp-route-SortBy="price_desc" class="filter-link stext-106 trans-04">
									Price: High to Low
								</a>
							</li>
						</ul>
					</div>

					<div class="filter-col2 p-r-15 p-b-27">
						<div class="mtext-102 cl2 p-b-15">
							Price
						</div>

						<ul>
							<li class="p-b-6">
								<a asp-controller="Product" asp-action="Index" class="filter-link stext-106 trans-04 filter-link-active">
									All
								</a>
							</li>

							<li class="p-b-6">
								<a asp-controller="Product" asp-action="Filter"
								   asp-route-MinPrice="0" asp-route-MaxPrice="300" class="filter-link stext-106 trans-04">
									0.00 LE - 300.00 LE
								</a>
							</li>

							<li class="p-b-6">
								<a asp-controller="Product" asp-action="Filter"
								   asp-route-MinPrice="300" asp-route-MaxPrice="500" class="filter-link stext-106 trans-04">
									300.00 LE - 500.00 LE
								</a>
							</li>

							<li class="p-b-6">
								<a asp-controller="Product" asp-action="Filter"
								   asp-route-MinPrice="500" asp-route-MaxPrice="800" class="filter-link stext-106 trans-04">
									500.00 LE - 800.00 LE
								</a>
							</li>

							<li class="p-b-6">
								<a asp-controller="Product" asp-action="Filter"
								   asp-route-MinPrice="800" asp-route-MaxPrice="1000" class="filter-link stext-106 trans-04">
									800.00 LE - 1000.00 LE
								</a>
							</li>

							<li class="p-b-6">
								<a asp-controller="Product" asp-action="Filter"
								   asp-route-MinPrice="1000" class="filter-link stext-106 trans-04">
									1000.00 LE +
								</a>
							</li>
						</ul>
					</div>
					<div class="filter-col4 p-b-27">
						<div class="mtext-102 cl2 p-b-15">
							Tags
						</div>
						<ul>
							<li class="p-b-6">
								<a asp-controller="Product" asp-action="Filter" asp-route-Tag="Denim"
								   class="filter-link stext-106 trans-04">
									Denim
								</a>
							</li>

							<li class="p-b-6">
								<a asp-controller="Product" asp-action="Filter" asp-route-Tag="SportsWear"
								   class="filter-link stext-106 trans-04">
									SportsWear
								</a>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>

		<div class="row isotope-grid" style="position: relative;">
			@foreach (var item in Model)
			{
				<div class="col-sm-6 col-md-4 col-lg-3 p-b-35 isotope-item @item.CategoryName.ToLower()">
					<div class="block2">
						<div class="block2-pic hov-img0">
							<img src="~/images/productImages/@item.ImageUrl" alt="IMG-PRODUCT">
							<a asp-controller="ProductDetail"
							   asp-action="Index"
							   asp-route-id="@item.Id"
							   class="block2-btn flex-c-m stext-103 cl2 size-102 bg0 bor2 hov-btn1 p-lr-15 trans-04">
								View Details
							</a>
						</div>

						<div class="block2-txt flex-w flex-t p-t-14">
							<div class="block2-txt-child1 flex-col-l">
								<a asp-controller="ProductDetail"
								   asp-action="Index"
								   asp-route-id="@item.Id"
								   class="stext-104 cl4 hov-cl1 trans-04 js-name-b2 p-b-6">
									@item.Name
								</a>

								<span class="stext-105 cl3">
									@item.Price LE
								</span>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
</div>
@section Scripts {
	<script src="~/js/product-live.js"></script>
}