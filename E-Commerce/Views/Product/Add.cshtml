@model E_Commerce.ViewModels.Product.ProductCreateVM

@{
    ViewData["Title"] = "Add Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="main-wrapper">
<div class="container-fluid py-4">

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">

            <h4 class="mb-4 fw-bold">Add New Product</h4>

            <form asp-action="Add" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">

                    <!-- Name -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Name" class="form-control" placeholder="Product Name" />
                            <label>Product Name</label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Category -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                                <option value="">Select Category</option>
                            </select>
                            <label>Category</label>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Price -->
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input asp-for="Price" class="form-control" placeholder="Price" />
                            <label>Price</label>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <div class="form-floating">
                            <textarea asp-for="Description" class="form-control"
                                      placeholder="Description"
                                      style="height:120px"></textarea>
                            <label>Description</label>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Variants Section -->
                    <div class="col-12">
                        <h5 class="mt-4 mb-3">Product Variants</h5>
                        <div id="variants-container">
                            <div class="variant-row mb-3 p-3 border rounded bg-light">
                                <div class="row">
                                    <div class="col-md-4 mb-2">
                                        <label class="form-label">Size</label>
                                        <input type="text" name="Variants[0].Size" class="form-control" placeholder="e.g., S, M, L, XL" />
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <label class="form-label">Color</label>
                                        <input type="text" name="Variants[0].Color" class="form-control" placeholder="e.g., Red, Blue" />
                                    </div>
                                    <div class="col-md-3 mb-2">
                                        <label class="form-label">Stock</label>
                                        <input type="number" name="Variants[0].Stock" class="form-control" min="0" />
                                    </div>
                                    <div class="col-md-1 mb-2 d-flex align-items-end">
                                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariant(this)">Remove</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-secondary mt-2" onclick="addVariant()">+ Add Variant</button>
                    </div>



                </div>

                <hr class="my-4" />

                <div class="row g-4">

                    <!-- Main Image -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Main Image *</label>
                        <input asp-for="MainImage" type="file" class="form-control"
                               accept="image/*"
                               onchange="previewImage(this, 'mainPreview')" />
                        <span asp-validation-for="MainImage" class="text-danger small"></span>

                        <img id="mainPreview" class="mt-2 rounded d-none border"
                             style="width:120px;height:120px;object-fit:cover;" />
                    </div>

                    <!-- Extra Images -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Extra Images</label>

                        @for (int i = 1; i <= 3; i++)
                        {
                            <div class="mb-2">
                                <input name="ExtraImage@(i)" type="file" class="form-control"
                                       accept="image/*"
                                       onchange="previewImage(this, 'extraPreview@(i)')" />

                                <img id="extraPreview@(i)" class="mt-1 rounded d-none border"
                                     style="width:70px;height:70px;object-fit:cover;" />
                            </div>
                        }
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a href="/admin/products" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4">
                        Add Product
                    </button>
                </div>

            </form>

        </div>
    </div>

</div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let variantIndex = 1;

        function previewImage(input, previewId) {
            const preview = document.getElementById(previewId);

            if (input.files && input.files[0]) {
                const reader = new FileReader();

                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                };

                reader.readAsDataURL(input.files[0]);
            } else {
                preview.classList.add('d-none');
            }
        }

        function addVariant() {
            const container = document.getElementById('variants-container');
            const newVariant = document.createElement('div');
            newVariant.className = 'variant-row mb-3 p-3 border rounded bg-light';
            newVariant.innerHTML = `
                <div class="row">
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Size</label>
                        <input type="text" name="Variants[${variantIndex}].Size" class="form-control" placeholder="e.g., S, M, L, XL" />
                    </div>
                    <div class="col-md-4 mb-2">
                        <label class="form-label">Color</label>
                        <input type="text" name="Variants[${variantIndex}].Color" class="form-control" placeholder="e.g., Red, Blue" />
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="form-label">Stock</label>
                        <input type="number" name="Variants[${variantIndex}].Stock" class="form-control" min="0" />
                    </div>
                    <div class="col-md-1 mb-2 d-flex align-items-end">
                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariant(this)">Remove</button>
                    </div>
                </div>
            `;
            container.appendChild(newVariant);
            variantIndex++;
        }

        function removeVariant(button) {
            button.closest('.variant-row').remove();
        }
    </script>

}