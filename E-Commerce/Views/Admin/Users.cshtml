@using E_Commerce.ViewModels.AdminDashboard
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model AdminDashboardDetailVM

<!-- ── Sidebar Overlay ───────────────────────────────────────────────── -->
<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>


<!-- ── Main Wrapper ─────────────────────────────────────────────────── -->
<div class="main-wrapper">

    <!-- ── Page Content ─────────────────────────────────────────────── -->
    <main class="page-content">
        <div class="page-header">
            <div>
                <h1>User Management</h1>
                <p>Manage roles, permissions, and account status.</p>
            </div>
        </div>

        <div class="card-box">
            <!-- Filters Row -->
            <div class="d-flex align-items-center gap-2 mb-3 flex-wrap" id="userFilters">
                <input type="text" id="globalSearch" placeholder="Search users…" style="border:1.5px solid var(--border);border-radius:8px;padding:6px 12px;font-size:13px;font-family:var(--font);width:200px" oninput="loadUsers(1)" />
                <select id="statusFilter" style="width:auto;font-family:var(--font);font-size:12.5px;border-radius:8px;border:1.5px solid var(--border);padding:6px 12px" onchange="loadUsers(1)">
                    <option value="">All Statuses</option>
                    <option value="Active">Active</option>
                    <option value="Banned">Banned</option>
                </select>
                <select id="roleFilter" style="width:auto;font-family:var(--font);font-size:12.5px;border-radius:8px;border:1.5px solid var(--border);padding:6px 12px" onchange="loadUsers(1)">
                    <option value="">All Roles</option>
                    @foreach (var role in Model.Roles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <button class="btn-primary-custom" onclick="loadUsers(1)" style="padding:6px 16px;font-size:13px">
                    <i class="bi bi-search"></i> Search
                </button>
                <button type="button" class="btn btn-outline-secondary" onclick="resetUsersFilters()" style="padding:6px 16px;font-size:13px">
                    <i class="bi bi-x-lg"></i> Reset
                </button>
            </div>

            @if (Model.UserPagination.Users.Any())
            {
                <div id="usersTableContainer">
                    @await Html.PartialAsync("_UsersTable", Model.UserPagination)
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <p class="text-muted">No users found</p>
                </div>
            }
        </div>
    </main>
</div>

<div id="notificationContainer" class="notification-container">
    @if (TempData["StatusMessage"] != null)
    {
        <div class="alert alert-@(TempData["StatusType"] ?? "info") alert-dismissible fade show" role="alert">
            @TempData["StatusMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
</div>

<div class="modal fade" id="editUserRoleModal" tabindex="-1" aria-labelledby="editUserRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editUserRoleModalLabel">Assign Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editUserRoleForm">
                    <input type="hidden" id="selectedUserId" />
                    <div class="mb-3">
                        <label class="form-label-custom">Choose Role</label>
                        <select id="userRoleSelect" class="form-control-custom" onchange="toggleNewRoleInput(this)">
                            <option value="">Select a role</option>
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role">@role</option>
                            }
                            <option value="new-role">Add new role</option>
                        </select>
                    </div>
                    <div class="mb-3" id="newUserRoleRow" style="display:none;">
                        <label class="form-label-custom">New Role Name</label>
                        <input type="text" id="newUserRoleName" class="form-control-custom" placeholder="Enter role name" />
                    </div>
                </form>
            </div>
            <div class="modal-footer d-flex justify-content-end">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-primary-custom" onclick="submitUserRole()">Save Role</button>
            </div>
        </div>
    </div>
</div>


<!-- JavaScript Functions -->
<script>
    function openUserRoleModal(userId) {
        const selectedUserId = document.getElementById('selectedUserId');
        const roleSelect = document.getElementById('userRoleSelect');
        const newRoleRow = document.getElementById('newUserRoleRow');
        const newRoleInput = document.getElementById('newUserRoleName');

        if (!selectedUserId || !roleSelect) return;

        selectedUserId.value = userId;
        roleSelect.value = '';
        newRoleRow.style.display = 'none';
        if (newRoleInput) {
            newRoleInput.value = '';
        }

        const modalEl = document.getElementById('editUserRoleModal');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
    }

    function submitUserRole() {
        const userId = document.getElementById('selectedUserId')?.value;
        const roleSelect = document.getElementById('userRoleSelect');
        const newRoleInput = document.getElementById('newUserRoleName');

        if (!userId || !roleSelect) {
            showNotification('Unable to assign role.', 'danger');
            return;
        }

        const selectedRole = roleSelect.value;
        const newRoleName = newRoleInput?.value.trim();
        const roleName = selectedRole === 'new-role' ? newRoleName : selectedRole;

        if (!roleName) {
            showNotification('Please choose or enter a role.', 'danger');
            return;
        }

        fetch('/Admin/UsersRole/' + userId, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ roleName: roleName })
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const modalEl = document.getElementById('editUserRoleModal');
                    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    if (modal) {
                        modal.hide();
                    }
                    loadUsers();
                    showNotification('User role updated.', 'success');
                } else {
                    showNotification(data.message || 'Error updating role', 'danger');
                }
            })
            .catch(() => showNotification('Error updating role', 'danger'));
    }

    function toggleNewRoleInput(selectElement) {
        const newRoleRow = document.getElementById('newUserRoleRow');
        if (!newRoleRow) return;
        newRoleRow.style.display = selectElement?.value === 'new-role' ? 'block' : 'none';
    }

    function editUserStatus(userId, newStatus) {
        if (!confirm('Do you want to ' + (newStatus === 'Banned' ? 'ban' : 'unban') + ' this user?')) {
            return;
        }

        fetch('/Admin/UpdateUserStatus/' + userId, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({ status: newStatus })
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    loadUsers();
                    showNotification('User status updated.', 'success');
                } else {
                    showNotification(data.message || 'Error updating status', 'danger');
                }
            })
            .catch(() => showNotification('Error updating status', 'danger'));
    }



         function loadUsers(pageNumber = 1) {
        const searchTerm = document.getElementById('globalSearch')?.value || '';
        const status = document.getElementById('statusFilter')?.value || '';
        const role = document.getElementById('roleFilter')?.value || '';

        const url = '/Admin/UsersTable?searchTerm=' + encodeURIComponent(searchTerm)
            + '&status=' + encodeURIComponent(status)
            + '&role=' + encodeURIComponent(role)
            + '&pageNumber=' + pageNumber;

        fetch(url)
            .then(response => response.text())
            .then(html => {
                const container = document.getElementById('usersTableContainer');
                if (container) {
                    container.innerHTML = html;
                }
            })
            .catch(error => {
                console.error('Error loading users:', error);
            });
    }

    function resetUsersFilters() {
        document.getElementById('globalSearch').value = '';
        document.getElementById('statusFilter').value = '';
        document.getElementById('roleFilter').value = '';
        loadUsers(1);
    }

    function showNotification(message, type) {
        const container = document.getElementById('notificationContainer');
        if (!container) {
            console.log(message, type);
            return;
        }

        const alert = document.createElement('div');
        alert.className = `alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible fade show`;
        alert.role = 'alert';
        alert.innerHTML = `
            <div>${message}</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        `;

        container.appendChild(alert);
        setTimeout(() => {
            const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
            bsAlert.close();
        }, 5000);
    }

    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        sidebar?.classList.toggle('active');
        overlay?.classList.toggle('active');
    }
</script>