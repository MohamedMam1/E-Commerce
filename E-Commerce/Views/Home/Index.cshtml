@{
	ViewData["Title"] = "Home Page";
}
<style>
	/* ── SHARED UTILITIES ── */
	.eyebrow {
		font-family: var(--ff-sans);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--gold);
	}

	.display-serif {
		font-family: var(--ff-serif);
		font-weight: 300;
		line-height: 1.15;
		color: var(--ink);
	}

	.section-divider {
		width: 40px;
		height: 1px;
		background: var(--gold);
		display: block;
		margin: 1.5rem auto;
	}

		.section-divider.left {
			margin: 1.5rem 0;
		}

	/* ══════════════════════════════════════
		   HERO SLIDER — unified with site design
		══════════════════════════════════════ */
	.section-slide .item-slick1 {
		background-size: cover;
		background-position: center;
		position: relative;
	}

		/* Dark overlay so text is always readable */
		.section-slide .item-slick1::before {
			content: '';
			position: absolute;
			inset: 0;
			z-index: 0;
		}

		.section-slide .item-slick1 > * {
			position: relative;
			z-index: 1;
		}

	/* Slide text — use site serif/sans */
	.section-slide .ltext-101 {
		font-family: var(--ff-sans);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.28em;
		text-transform: uppercase;
		color: var(--gold) !important;
		display: block;
		margin-bottom: 1rem;
	}

	.section-slide .ltext-201 {
		font-family: var(--ff-serif) !important;
		font-size: clamp(3rem, 7vw, 5.5rem) !important;
		font-weight: 300 !important;
		line-height: 1.1 !important;
		color: black !important;
		letter-spacing: -0.01em;
	}

	/* CTA button — matches site gold palette */
	.section-slide .hov-btn1 {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--ff-sans);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--ink) !important;
		background: var(--gold) !important;
		border: 1px solid var(--gold) !important;
		padding: 14px 38px !important;
		border-radius: 2px !important;
		text-decoration: none;
		transition: background 0.35s ease, color 0.35s ease, border-color 0.35s ease;
	}

		.section-slide .hov-btn1:hover {
			background: transparent !important;
			color: var(--white) !important;
			border-color: rgba(255,255,255,0.6) !important;
		}

	/* ══════════════════════════════════════
		   SECTION 1 — BRAND STORY
		══════════════════════════════════════ */
	.brand-story {
		background: var(--ink);
		padding: 100px 0;
		position: relative;
		overflow: hidden;
	}

		.brand-story::before {
			content: '';
			position: absolute;
			top: -60px;
			right: -60px;
			width: 420px;
			height: 420px;
			border-radius: 50%;
			border: 1px solid rgba(176, 154, 126, 0.12);
			pointer-events: none;
		}

		.brand-story::after {
			content: '';
			position: absolute;
			bottom: -100px;
			left: -80px;
			width: 580px;
			height: 580px;
			border-radius: 50%;
			border: 1px solid rgba(176, 154, 126, 0.07);
			pointer-events: none;
		}

		.brand-story .story-year {
			font-family: var(--ff-serif);
			font-size: clamp(5rem, 12vw, 9rem);
			font-weight: 300;
			color: rgba(176, 154, 126, 0.10);
			line-height: 1;
			position: absolute;
			top: 60px;
			right: 5%;
			pointer-events: none;
			user-select: none;
		}

		.brand-story .display-serif {
			color: var(--white);
			font-size: clamp(2.2rem, 4.5vw, 3.4rem);
		}

		.brand-story .story-body {
			color: rgba(255,255,255,0.62);
			font-size: 0.95rem;
			line-height: 1.95;
			font-weight: 300;
		}

		.brand-story .story-pull {
			font-family: var(--ff-serif);
			font-size: clamp(1.15rem, 2vw, 1.4rem);
			font-weight: 400;
			font-style: italic;
			color: var(--gold);
			line-height: 1.7;
			border-left: 2px solid var(--gold);
			padding-left: 1.5rem;
			margin: 2.5rem 0;
		}

		.brand-story .stat-row {
			display: flex;
			gap: 3rem;
			margin-top: 2.8rem;
			padding-top: 2.8rem;
			border-top: 1px solid rgba(255,255,255,0.08);
		}

		.brand-story .stat-item .stat-num {
			font-family: var(--ff-serif);
			font-size: 2.2rem;
			font-weight: 300;
			color: var(--white);
			line-height: 1;
		}

		.brand-story .stat-item .stat-label {
			font-size: 0.7rem;
			font-weight: 500;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			color: var(--stone);
			margin-top: 6px;
		}

	/* ══════════════════════════════════════
		   SECTION 2 — WHY CHOOSE US
		══════════════════════════════════════ */
	.why-us {
		background: var(--cream);
		padding: 100px 0;
	}

	.trust-card {
		padding: 2.4rem 2rem;
		border: 1px solid var(--sand);
		border-radius: 4px;
		background: var(--white);
		height: 100%;
		transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
		position: relative;
		overflow: hidden;
	}

		.trust-card::after {
			content: '';
			position: absolute;
			bottom: 0;
			left: 0;
			height: 3px;
			width: 0;
			background: var(--gold);
			transition: width 0.4s ease;
		}

		.trust-card:hover {
			border-color: var(--gold);
			transform: translateY(-5px);
			box-shadow: 0 16px 40px rgba(42,39,36,0.07);
		}

			.trust-card:hover::after {
				width: 100%;
			}

		.trust-card .tc-icon {
			width: 52px;
			height: 52px;
			border-radius: 50%;
			background: var(--parchment);
			display: flex;
			align-items: center;
			justify-content: center;
			margin-bottom: 1.5rem;
			font-size: 1.3rem;
			color: var(--gold);
			transition: background 0.3s, color 0.3s;
		}

		.trust-card:hover .tc-icon {
			background: var(--ink);
			color: var(--gold);
		}

		.trust-card .tc-title {
			font-family: var(--ff-sans);
			font-size: 0.8rem;
			font-weight: 600;
			letter-spacing: 0.18em;
			text-transform: uppercase;
			color: var(--ink);
			margin-bottom: 0.9rem;
		}

		.trust-card .tc-body {
			font-size: 0.88rem;
			line-height: 1.85;
			color: var(--stone);
			font-weight: 300;
		}

	/* ══════════════════════════════════════
		   SECTION 3 — FEATURED COLLECTIONS
		══════════════════════════════════════ */
	.collections {
		background: var(--parchment);
		padding: 100px 0;
	}

	.collections-intro {
		max-width: 620px;
	}

		.collections-intro .display-serif {
			font-size: clamp(2rem, 4vw, 3rem);
		}

		.collections-intro p {
			color: var(--stone);
			font-size: 0.93rem;
			line-height: 1.9;
			font-weight: 300;
		}

	.coll-item {
		padding: 2.5rem 0;
		border-bottom: 1px solid var(--sand);
		display: flex;
		align-items: flex-start;
		gap: 2rem;
		transition: all 0.3s ease;
		cursor: default;
	}

		.coll-item:first-of-type {
			border-top: 1px solid var(--sand);
		}

		.coll-item:hover .coll-num {
			color: var(--gold);
		}

		.coll-item:hover .coll-title {
			letter-spacing: 0.04em;
		}

	.coll-num {
		font-family: var(--ff-serif);
		font-size: 0.85rem;
		font-weight: 400;
		color: var(--sand);
		padding-top: 5px;
		min-width: 28px;
		transition: color 0.3s;
	}

	.coll-content {
		flex: 1;
	}

	.coll-title {
		font-family: var(--ff-serif);
		font-size: clamp(1.5rem, 3vw, 2.1rem);
		font-weight: 300;
		color: var(--ink);
		line-height: 1.2;
		transition: letter-spacing 0.4s ease;
		margin-bottom: 0.6rem;
	}

	.coll-desc {
		font-size: 0.85rem;
		color: var(--stone);
		line-height: 1.8;
		font-weight: 300;
		max-width: 480px;
	}

	.coll-tag {
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gold);
		border: 1px solid var(--gold);
		padding: 3px 10px;
		border-radius: 20px;
		margin-left: auto;
		align-self: center;
		white-space: nowrap;
	}

	/* ══════════════════════════════════════
		   SECTION 4 — TESTIMONIALS
		══════════════════════════════════════ */
	.testimonials {
		background: var(--white);
		padding: 100px 0;
	}

	.testi-card {
		background: var(--cream);
		border: 1px solid var(--sand);
		border-radius: 4px;
		padding: 2.5rem 2.2rem;
		height: 100%;
		position: relative;
	}

		.testi-card .quote-mark {
			font-family: var(--ff-serif);
			font-size: 5rem;
			line-height: 0.6;
			color: var(--gold);
			opacity: 0.35;
			margin-bottom: 1.2rem;
			display: block;
		}

		.testi-card .testi-text {
			font-family: var(--ff-serif);
			font-size: 1.05rem;
			font-style: italic;
			font-weight: 300;
			color: var(--ink);
			line-height: 1.85;
			margin-bottom: 2rem;
		}

		.testi-card .testi-stars {
			color: var(--gold);
			font-size: 0.75rem;
			letter-spacing: 3px;
			margin-bottom: 1rem;
		}

		.testi-card .testi-author {
			display: flex;
			align-items: center;
			gap: 0.9rem;
			padding-top: 1.4rem;
			border-top: 1px solid var(--sand);
		}

		.testi-card .author-avatar {
			width: 40px;
			height: 40px;
			border-radius: 50%;
			background: var(--ink);
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 0.72rem;
			font-weight: 600;
			color: var(--gold);
			letter-spacing: 0.05em;
			flex-shrink: 0;
		}

		.testi-card .author-name {
			font-size: 0.82rem;
			font-weight: 600;
			color: var(--ink);
			letter-spacing: 0.04em;
		}

		.testi-card .author-role {
			font-size: 0.73rem;
			color: var(--stone);
			font-weight: 300;
			margin-top: 2px;
		}

	/* ── RESPONSIVE ── */
	@@media (max-width: 768px) {
		.brand-story .stat-row {
			gap: 1.8rem;
		}

		.coll-tag {
			display: none;
		}

		.brand-story, .why-us, .collections, .testimonials {
			padding: 70px 0;
		}
	}
</style>


<!-- ══════════════════════════════════════════════════════
	 HERO SLIDER
══════════════════════════════════════════════════════ -->
<section class="section-slide">
	<div class="wrap-slick1">
		<div class="slick1">

			<div class="item-slick1" style="background-image: url(images/slide-01.jpg);">
				<div class="container h-full">
					<div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
						<div class="layer-slick1 animated visible-false" data-appear="fadeInDown" data-delay="0">
							<span class="ltext-101 cl2 respon2">Women Collection 2026</span>
						</div>
						<div class="layer-slick1 animated visible-false" data-appear="fadeInUp" data-delay="800">
							<h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">New Season</h2>
						</div>
						<div class="layer-slick1 animated visible-false" data-appear="zoomIn" data-delay="1600">
							<a asp-controller="Product" asp-action="Index" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
								Shop Now
							</a>
						</div>
					</div>
				</div>
			</div>

			<div class="item-slick1" style="background-image: url(images/slide-02.jpg);">
				<div class="container h-full">
					<div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
						<div class="layer-slick1 animated visible-false" data-appear="rollIn" data-delay="0">
							<span class="ltext-101 cl2 respon2">Men New-Season</span>
						</div>
						<div class="layer-slick1 animated visible-false" data-appear="lightSpeedIn" data-delay="800">
							<h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">Jackets &amp; Coats</h2>
						</div>
						<div class="layer-slick1 animated visible-false" data-appear="slideInUp" data-delay="1600">
							<a asp-controller="Product" asp-action="Index" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
								Shop Now
							</a>
						</div>
					</div>
				</div>
			</div>

			<div class="item-slick1" style="background-image: url(images/slide-03.jpg);">
				<div class="container h-full">
					<div class="flex-col-l-m h-full p-t-100 p-b-30 respon5">
						<div class="layer-slick1 animated visible-false" data-appear="rotateInDownLeft" data-delay="0">
							<span class="ltext-101 cl2 respon2">Men Collection 2026</span>
						</div>
						<div class="layer-slick1 animated visible-false" data-appear="rotateInUpRight" data-delay="800">
							<h2 class="ltext-201 cl2 p-t-19 p-b-43 respon1">New Arrivals</h2>
						</div>
						<div class="layer-slick1 animated visible-false" data-appear="rotateIn" data-delay="1600">
							<a asp-controller="Product" asp-action="Index" class="flex-c-m stext-101 cl0 size-101 bg1 bor1 hov-btn1 p-lr-15 trans-04">
								Shop Now
							</a>
						</div>
					</div>
				</div>
			</div>

		</div>
	</div>
</section>


<!-- ══════════════════════════════════════════════════════
	 SECTION 1 — BRAND STORY
══════════════════════════════════════════════════════ -->
<section class="brand-story">
	<div class="story-year">EST.</div>
	<div class="container">
		<div class="row align-items-center gy-5">

			<div class="col-lg-5">
				<span class="eyebrow">Our Story</span>
				<span class="section-divider left"></span>
				<h2 class="display-serif" style="font-size:clamp(2.2rem,4.5vw,3.4rem);">
					Crafted with<br>
					<em>intention,</em><br>
					worn with purpose.
				</h2>
			</div>

			<div class="col-lg-6 offset-lg-1">
				<p class="story-body">
					We started with a single belief — that clothing should feel as good as it looks. Not fast. Not disposable. Built around real people, real wardrobes, and the idea that great style is a quiet confidence, not a loud statement.
				</p>
				<blockquote class="story-pull">
					"Every piece we design begins with a question: will this still be worn five years from now?"
				</blockquote>
				<p class="story-body">
					From our sourcing partners to our studio team, every decision we make is guided by quality, longevity, and a deep respect for the craft of dressmaking. We believe in fewer, better — and we design accordingly.
				</p>
				<div class="stat-row flex-wrap">
					<div class="stat-item">
						<div class="stat-num">12+</div>
						<div class="stat-label">Years of Craft</div>
					</div>
					<div class="stat-item">
						<div class="stat-num">40+</div>
						<div class="stat-label">Countries Served</div>
					</div>
					<div class="stat-item">
						<div class="stat-num">100%</div>
						<div class="stat-label">Ethical Sourcing</div>
					</div>
				</div>
			</div>

		</div>
	</div>
</section>


<!-- ══════════════════════════════════════════════════════
	 SECTION 2 — WHY CHOOSE US
══════════════════════════════════════════════════════ -->
<section class="why-us">
	<div class="container">

		<div class="text-center mb-5 pb-2">
			<span class="eyebrow">Why Choose Us</span>
			<span class="section-divider"></span>
			<h2 class="display-serif" style="font-size:clamp(1.9rem,3.5vw,2.8rem);">
				The difference is in<br><em>the details</em>
			</h2>
		</div>

		<div class="row g-4 mt-2">

			<div class="col-sm-6 col-lg-3">
				<div class="trust-card">
					<div class="tc-icon"><i class="bi bi-scissors"></i></div>
					<div class="tc-title">Premium Materials</div>
					<p class="tc-body">We source only from certified mills and ethical suppliers. Every fabric passes a rigorous quality check before it reaches our studio floor.</p>
				</div>
			</div>

			<div class="col-sm-6 col-lg-3">
				<div class="trust-card">
					<div class="tc-icon"><i class="bi bi-patch-check"></i></div>
					<div class="tc-title">Expert Tailoring</div>
					<p class="tc-body">Each garment is cut and finished by skilled artisans who care about the craft. Clean seams, precise fits — nothing leaves our studio untested.</p>
				</div>
			</div>

			<div class="col-sm-6 col-lg-3">
				<div class="trust-card">
					<div class="tc-icon"><i class="bi bi-arrow-repeat"></i></div>
					<div class="tc-title">Worry-Free Returns</div>
					<p class="tc-body">Not the right fit? We offer simple, no-fuss returns within 30 days. Your satisfaction is the standard we hold ourselves to every single day.</p>
				</div>
			</div>

			<div class="col-sm-6 col-lg-3">
				<div class="trust-card">
					<div class="tc-icon"><i class="bi bi-globe2"></i></div>
					<div class="tc-title">Sustainably Made</div>
					<p class="tc-body">From recycled packaging to low-waste production runs, our environmental commitments are built into our process — not bolted on as an afterthought.</p>
				</div>
			</div>

			<div class="col-sm-6 col-lg-3">
				<div class="trust-card">
					<div class="tc-icon"><i class="bi bi-person-lines-fill"></i></div>
					<div class="tc-title">Size Inclusivity</div>
					<p class="tc-body">Great style belongs to every body. Our collections are designed with a full size range in mind — because fashion should never be a privilege.</p>
				</div>
			</div>

			<div class="col-sm-6 col-lg-3">
				<div class="trust-card">
					<div class="tc-icon"><i class="bi bi-chat-heart"></i></div>
					<div class="tc-title">Personal Styling</div>
					<p class="tc-body">Unsure what to pair or how to build a capsule wardrobe? Our style advisors are available to guide you through every season.</p>
				</div>
			</div>

			<div class="col-sm-6 col-lg-3">
				<div class="trust-card">
					<div class="tc-icon"><i class="bi bi-truck"></i></div>
					<div class="tc-title">Fast Delivery</div>
					<p class="tc-body">Orders are processed same-day and dispatched within 24 hours. We partner with trusted carriers to ensure your order arrives on time, every time.</p>
				</div>
			</div>

			<div class="col-sm-6 col-lg-3">
				<div class="trust-card">
					<div class="tc-icon"><i class="bi bi-shield-lock"></i></div>
					<div class="tc-title">Secure Shopping</div>
					<p class="tc-body">Your data and payments are always protected. We use end-to-end encryption across our entire checkout — shop with total confidence.</p>
				</div>
			</div>

		</div>
	</div>
</section>


<!-- ══════════════════════════════════════════════════════
	 SECTION 3 — FEATURED COLLECTIONS
══════════════════════════════════════════════════════ -->
<section class="collections">
	<div class="container">

		<div class="row gy-5 align-items-start">

			<div class="col-lg-4">
				<div class="collections-intro">
					<span class="eyebrow">Collections</span>
					<span class="section-divider left"></span>
					<h2 class="display-serif" style="font-size:clamp(2rem,4vw,3rem); margin-bottom: 1.5rem;">
						Curated for<br>every<br><em>chapter of life</em>
					</h2>
					<p>
						Each collection is built around a mood, a season, and a lifestyle. Not trends. Not fast fashion. Just thoughtfully designed pieces that earn their place in your wardrobe and stay there.
					</p>
				</div>
			</div>

			<div class="col-lg-7 offset-lg-1">

				<div class="coll-item">
					<span class="coll-num">01</span>
					<div class="coll-content">
						<h3 class="coll-title">The Essentials Edit</h3>
						<p class="coll-desc">Timeless wardrobe foundations — neutral tones, relaxed silhouettes, and fabrics that move with you. Designed to be layered, mixed, and worn daily without thinking.</p>
					</div>
					<span class="coll-tag">Women · Men</span>
				</div>

				<div class="coll-item">
					<span class="coll-num">02</span>
					<div class="coll-content">
						<h3 class="coll-title">Urban Professional</h3>
						<p class="coll-desc">Sharp tailoring meets modern comfort. This collection is for those who need to look polished from 9am to 9pm — without changing twice.</p>
					</div>
					<span class="coll-tag">Workwear</span>
				</div>

				<div class="coll-item">
					<span class="coll-num">03</span>
					<div class="coll-content">
						<h3 class="coll-title">Weekend Luxe</h3>
