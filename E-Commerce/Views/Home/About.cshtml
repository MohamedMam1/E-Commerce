@{
    ViewData["Title"] = "About";
}

<style>
    :root {
        --gold: #B09A7E;
        --gold-light: #c8b49a;
        --gold-pale: #F0EBE3;
        --gold-dim: rgba(184,150,62,0.10);
        --dark: #2A2724;
        --dark2: #2A2724;
        --dark3: #3a3633;
        --light: #F9F6F1;
        --light2: #F0EBE3;
        --cream: #D6CFC4;
        --muted: #7a7a7a;
        --muted2: #aaaaaa;
        --border-dark: rgba(184,150,62,0.15);
        --border-light: #D6CFC4;
        --font-serif: 'Cormorant Garamond', Georgia, serif;
        --font-alt: 'Cormorant Garamond', Georgia, serif;
        --font-sans: 'Jost', sans-serif;
    }

    .about-page {
        font-family: var(--font-sans);
    }

    /* ── HERO ───────────────────────────────────────────── */
    .ab-hero {
        background: var(--dark);
        min-height: 520px;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        .ab-hero::before {
            content: '';
            position: absolute;
            top: -200px;
            right: -100px;
            width: 500px;
            height: 900px;
            background: linear-gradient(135deg, rgba(184,150,62,0.06) 0%, transparent 60%);
            transform: rotate(-15deg);
            pointer-events: none;
        }

        .ab-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(184,150,62,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(184,150,62,0.05) 1px, transparent 1px);
            background-size: 72px 72px;
            pointer-events: none;
        }

    .ab-hero-inner {
        position: relative;
        z-index: 2;
        padding: 110px 0 100px;
    }

    .ab-hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: var(--gold-light);
        margin-bottom: 28px;
    }

        .ab-hero-tag::before {
            content: '';
            display: block;
            width: 30px;
            height: 1px;
            background: var(--gold-light);
        }

    .ab-hero-h1 {
        font-family: var(--font-serif);
        font-size: clamp(3.2rem, 7vw, 6rem);
        font-weight: 400;
        color: #fff;
        line-height: 1.0;
        letter-spacing: -0.02em;
        margin-bottom: 0;
    }

        .ab-hero-h1 em {
            font-style: italic;
            color: var(--gold-light);
            font-weight: 400;
        }

    .ab-hero-sub {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 300;
        letter-spacing: 0.08em;
        color: var(--muted2);
        line-height: 2;
        max-width: 360px;
        margin-top: 28px;
    }

    .ab-hero-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        justify-content: center;
        height: 100%;
        padding: 110px 0;
        gap: 24px;
    }

    .ab-hero-vertical {
        writing-mode: vertical-rl;
        text-orientation: mixed;
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: rgba(184,150,62,0.45);
        transform: rotate(180deg);
    }

    .ab-hero-vline {
        width: 1px;
        height: 120px;
        background: linear-gradient(180deg, transparent, var(--gold-light), transparent);
        margin-left: auto;
    }

    /* ── SECTION LABELS ─────────────────────────────────── */
    .ab-tag {
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: var(--gold);
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

        .ab-tag::after {
            content: '';
            display: block;
            width: 40px;
            height: 1px;
            background: var(--gold);
        }

    .ab-h2 {
        font-family: var(--font-serif);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 400;
        color: var(--dark);
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-bottom: 0;
    }

        .ab-h2 em {
            font-style: italic;
            color: var(--gold);
        }

    .ab-h2-light {
        font-family: var(--font-serif);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 400;
        color: #fff;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-bottom: 0;
    }

        .ab-h2-light em {
            font-style: italic;
            color: var(--gold-light);
        }

    .ab-p {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 300;
        color: var(--muted);
        line-height: 2;
        letter-spacing: 0.03em;
    }

    /* ── STORY SECTION ──────────────────────────────────── */
    .ab-story {
        background: var(--light);
        padding: 90px 0;
    }

    .ab-blockquote {
        border-left: 2px solid var(--gold);
        padding: 18px 24px;
        background: #fff;
        margin: 36px 0;
        box-shadow: 0 2px 20px rgba(0,0,0,0.04);
    }

        .ab-blockquote p {
            font-family: var(--font-serif);
            font-size: 1.25rem;
            font-weight: 400;
            font-style: italic;
            color: var(--dark);
            line-height: 1.7;
            margin: 0;
        }

    /* ── FEATURES ───────────────────────────────────────── */
    .ab-features {
        background: var(--light2);
        padding: 90px 0;
    }

    .ab-feat-card {
        background: #fff;
        border: 1px solid var(--border-light);
        padding: 36px 28px 32px;
        height: 100%;
        position: relative;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

        .ab-feat-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--gold), var(--gold-light));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.4s ease;
        }

        .ab-feat-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 60px rgba(0,0,0,0.08), 0 4px 12px rgba(184,150,62,0.1);
            border-color: var(--cream);
        }

            .ab-feat-card:hover::after {
                transform: scaleX(1);
            }

    .ab-feat-num {
        font-family: var(--font-alt);
        font-size: 3rem;
        font-weight: 300;
        color: var(--cream);
        line-height: 1;
        margin-bottom: 16px;
        letter-spacing: -0.03em;
    }

    .ab-feat-icon {
        width: 44px;
        height: 44px;
        background: var(--dark);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        transition: background 0.3s;
    }

    .ab-feat-card:hover .ab-feat-icon {
        background: var(--gold);
    }

    .ab-feat-label {
        font-family: var(--font-sans);
        font-size: 8px;
        font-weight: 600;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 8px;
        display: block;
    }

    .ab-feat-title {
        font-family: var(--font-serif);
        font-size: 1.2rem;
        font-weight: 500;
        color: var(--dark);
        margin-bottom: 10px;
        letter-spacing: -0.01em;
    }

    .ab-feat-text {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 300;
        color: var(--muted);
        line-height: 1.9;
        margin: 0;
        letter-spacing: 0.02em;
    }

    /* ── NUMBERS STRIP ──────────────────────────────────── */
    .ab-numbers {
        background: var(--dark2);
        padding: 90px 0;
        position: relative;
        overflow: hidden;
    }

        .ab-numbers::before,
        .ab-numbers::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent 0%, var(--gold) 30%, var(--gold-light) 50%, var(--gold) 70%, transparent 100%);
        }

        .ab-numbers::before {
            top: 0;
        }

        .ab-numbers::after {
            bottom: 0;
        }

    .ab-num-big {
        font-family: var(--font-serif);
        font-size: clamp(3.5rem, 8vw, 6.5rem);
        font-weight: 400;
        color: var(--gold);
        line-height: 1;
        letter-spacing: -0.04em;
        opacity: 0.75;
    }

    .ab-num-title {
        font-family: var(--font-serif);
        font-size: 1rem;
        font-weight: 500;
        color: #fff;
        letter-spacing: 0.05em;
        margin-bottom: 10px;
    }

    .ab-num-text {
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 300;
        color: var(--muted2);
        line-height: 2;
        letter-spacing: 0.04em;
        margin: 0;
    }

    .ab-num-sep {
        width: 1px;
        background: rgba(184,150,62,0.2);
        align-self: stretch;
        min-height: 100px;
    }

    /* ── TIMELINE ───────────────────────────────────────── */
    .ab-timeline {
        background: var(--dark);
        padding: 90px 0;
        position: relative;
    }

        .ab-timeline::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(184,150,62,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(184,150,62,0.03) 1px, transparent 1px);
            background-size: 72px 72px;
            pointer-events: none;
        }

    .ab-tl-item {
        display: flex;
        gap: 28px;
        margin-bottom: 44px;
    }

        .ab-tl-item:last-child {
            margin-bottom: 0;
        }

    .ab-tl-spine {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
        width: 24px;
    }

    .ab-tl-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--gold);
        flex-shrink: 0;
        box-shadow: 0 0 10px rgba(184,150,62,0.4);
    }

    .ab-tl-dot-empty {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        border: 1.5px solid var(--gold);
        flex-shrink: 0;
    }

    .ab-tl-line {
        width: 1px;
        background: rgba(184,150,62,0.2);
        flex: 1;
        margin-top: 6px;
    }

    .ab-tl-phase {
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 8px;
    }

    .ab-tl-title {
        font-family: var(--font-serif);
        font-size: 1.2rem;
        font-weight: 400;
        color: #fff;
        margin-bottom: 8px;
        letter-spacing: -0.01em;
    }

    .ab-tl-text {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 300;
        color: var(--muted2);
        line-height: 2;
        letter-spacing: 0.03em;
        margin: 0;
    }

    /* ── VALUES ─────────────────────────────────────────── */
    .ab-values {
        background: var(--light);
        padding: 90px 0;
    }

    .ab-val-item {
        padding: 32px 0;
        border-bottom: 1px solid var(--border-light);
        display: flex;
        align-items: flex-start;
        gap: 32px;
        transition: all 0.3s ease;
    }

        .ab-val-item:first-child {
            border-top: 1px solid var(--border-light);
        }

    .ab-val-num {
        font-family: var(--font-alt);
        font-size: 2.5rem;
        font-weight: 300;
        color: var(--cream);
        line-height: 1;
        flex-shrink: 0;
        width: 48px;
        transition: color 0.3s;
    }

    .ab-val-item:hover .ab-val-num {
        color: var(--gold-light);
    }

    .ab-val-title {
        font-family: var(--font-serif);
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--dark);
        margin-bottom: 6px;
        letter-spacing: -0.01em;
    }

    .ab-val-text {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 300;
        color: var(--muted);
        line-height: 2;
        letter-spacing: 0.03em;
        margin: 0;
    }

    /* ── CTA ────────────────────────────────────────────── */
    .ab-cta {
        background: var(--gold);
        padding: 80px 0;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .ab-cta::before {
            content: '';
            position: absolute;
            top: -80px;
            right: -80px;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255,255,255,0.06);
        }

        .ab-cta::after {
            content: '';
            position: absolute;
            bottom: -100px;
            left: 20%;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
        }

        .ab-cta h2 {
            font-family: var(--font-serif);
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            font-weight: 400;
            color: #fff;
            letter-spacing: -0.02em;
            margin-bottom: 10px;
        }

            .ab-cta h2 em {
                font-style: italic;
            }

        .ab-cta p {
            font-family: var(--font-sans);
            font-size: 12px;
            font-weight: 300;
            color: rgba(255,255,255,0.72);
            letter-spacing: 0.05em;
            margin-bottom: 36px;
        }

    .ab-cta-btn-dark {
        display: inline-block;
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #fff;
        background: var(--dark);
        padding: 14px 40px;
        text-decoration: none;
        border: 1px solid var(--dark);
        transition: all 0.3s ease;
        position: relative;
        z-index: 1;
    }

        .ab-cta-btn-dark:hover {
            background: transparent;
            color: #fff;
            border-color: rgba(255,255,255,0.6);
        }

    .ab-cta-btn-outline {
        display: inline-block;
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #fff;
        background: transparent;
        padding: 14px 40px;
        text-decoration: none;
        border: 1px solid rgba(255,255,255,0.5);
        transition: all 0.3s ease;
        position: relative;
        z-index: 1;
    }

        .ab-cta-btn-outline:hover {
            background: rgba(255,255,255,0.12);
            border-color: #fff;
            color: #fff;
        }

    @@media (max-width: 768px) {
        .ab-hero-right {
            display: none;
        }

        .ab-num-sep {
            display: none;
        }

        .ab-hero-h1 {
            font-size: 3rem;
        }

        .ab-val-item {
            flex-direction: column;
            gap: 12px;
        }
    }
</style>

<div class="about-page">

    <!-- ── HERO ──────────────────────────────────────────────── -->
    <section class="ab-hero">
        <div class="container ab-hero-inner">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="ab-hero-tag">Our Story</div>
                    <h1 class="ab-hero-h1">
                        More Than<br />
                        <em>A Fashion Store</em>
                    </h1>
                    <p class="ab-hero-sub">
                        Vestra is where curated style meets effortless shopping — built with care, designed with intention, and crafted for the modern wardrobe.
                    </p>
                </div>
                <div class="col-lg-3 offset-lg-1 d-none d-lg-flex ab-hero-right">
                    <div class="ab-hero-vline"></div>
                    <span class="ab-hero-vertical">Vestra — Est. 2020</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ── STORY ─────────────────────────────────────────────── -->
    <section class="ab-story">
        <div class="container">
            <div class="row align-items-start">
                <div class="col-lg-4 mb-5 mb-lg-0">
                    <div class="ab-tag">Our Story</div>
                    <h2 class="ab-h2">Built with<br /><em>Purpose</em></h2>
                    <div style="width:28px;height:1px;background:var(--gold);margin:24px 0;"></div>
                    <p class="ab-p">What began as an idea became a fully realized fashion destination — one that takes every detail of the shopping experience seriously.</p>
                </div>
                <div class="col-lg-7 offset-lg-1">
                    <p class="ab-p" style="margin-bottom:20px;">
                        Vestra was founded on a simple belief — that fashion should be accessible, beautiful, and effortless to explore. We set out to create a platform that doesn't just list products, but tells a story through every collection, every color, and every carefully chosen piece.
                    </p>
                    <p class="ab-p" style="margin-bottom:20px;">
                        From the very first page to the final checkout, every interaction on Vestra has been thoughtfully designed. We obsessed over the details — the typography, the spacing, the flow — so that you can focus entirely on discovering what you love.
                    </p>

                    <div class="ab-blockquote">
                        <p>"We didn't want to build something that just worked — we wanted to build something people would actually enjoy using."</p>
                    </div>

                    <p class="ab-p">
                                          Our catalog is curated with intention. Each product is selected to meet our standards of quality, style, and value. We believe that great fashion doesn't have to be complicated — and neither should shopping at Vestra.
  </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ── NUMBERS ────────────────────────────────────────────── -->
    <section class="ab-numbers">
        <div class="container">
            <div class="row justify-content-center text-center g-4 align-items-center">
                <div class="col-md-3">
                    <div class="ab-num-big">500+</div>
                    <h5 class="ab-num-title">Products</h5>
                    <p class="ab-num-text">A growing catalog of curated fashion pieces across every category and style.</p>
                </div>
                <div class="col-auto d-none d-md-flex ab-num-sep"></div>
                <div class="col-md-3">
                    <div class="ab-num-big">50+</div>
                    <h5 class="ab-num-title">Brands</h5>
                    <p class="ab-num-text">Partnered with trusted brands that share our commitment to quality and design.</p>
                </div>
                <div class="col-auto d-none d-md-flex ab-num-sep"></div>
                <div class="col-md-3">
                    <div class="ab-num-big">30d</div>
                    <h5 class="ab-num-title">Free Returns</h5>
                    <p class="ab-num-text">Shop with confidence — hassle-free returns accepted within 30 days, no questions asked.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ── FEATURES ───────────────────────────────────────────── -->
    <section class="ab-features">
        <div class="container">
            <div class="row align-items-end mb-5">
                <div class="col-lg-5">
                    <div class="ab-tag">What We Offer</div>
                    <h2 class="ab-h2">The Complete<br /><em>Experience</em></h2>
                </div>
                <div class="col-lg-5 offset-lg-2 pt-3">
                    <p class="ab-p">Everything a modern fashion shopper needs — thoughtfully built and beautifully delivered.</p>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-sm-6 col-xl-4">
                    <div class="ab-feat-card">
                        <div class="ab-feat-num">01</div>
                        <div class="ab-feat-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c8a96e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>
                        </div>
                        <span class="ab-feat-label">Catalog</span>
                        <h4 class="ab-feat-title">Curated Collections</h4>
                        <p class="ab-feat-text">Browse hundreds of fashion pieces organized by category, color, size, and price — with smart filters that make finding your style effortless.</p>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <div class="ab-feat-card">
                        <div class="ab-feat-num">02</div>
                        <div class="ab-feat-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c8a96e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" /></svg>
                        </div>
                        <span class="ab-feat-label">Shopping</span>
                        <h4 class="ab-feat-title">Seamless Cart</h4>
                        <p class="ab-feat-text">Add, remove, and update quantities with a persistent cart that reflects live stock — keeping your selections safe throughout your visit.</p>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <div class="ab-feat-card">
                        <div class="ab-feat-num">03</div>
                        <div class="ab-feat-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c8a96e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V22H4V12" /><path d="M22 7H2v5h20V7z" /><path d="M12 22V7" /><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z" /><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z" /></svg>
                        </div>
                        <span class="ab-feat-label">Wishlist</span>
                        <h4 class="ab-feat-title">Save Your Favourites</h4>
                        <p class="ab-feat-text">Bookmark the pieces you love and return to them anytime. Your wishlist is always there, waiting for when you're ready.</p>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                    <div class="ab-feat-card">
                        <div class="ab-feat-num">04</div>
                        <div class="ab-feat-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#c8a96e" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                        </div>
