@{
ViewData["Title"] = "Contact";
}

<style>
    :root {
        --gold: #B09A7E;
        --gold-light: #c8b49a;
        --gold-pale: #F0EBE3;
        --gold-dim: rgba(184,150,62,0.10);
        --dark: #2A2724;
        --dark2: #2A2724;
        --dark3: #3a3633;
        --light: #F9F6F1;
        --light2: #F0EBE3;
        --cream: #D6CFC4;
        --muted: #7a7a7a;
        --muted2: #aaaaaa;
        --border-dark: rgba(184,150,62,0.15);
        --border-light: #D6CFC4;
        --font-serif: 'Cormorant Garamond', Georgia, serif;
        --font-alt: 'Cormorant Garamond', Georgia, serif;
        --font-sans: 'Jost', sans-serif;
    }

    .contact-page {
        font-family: var(--font-sans);
    }

    /* ── HERO ───────────────────────────────────────────── */
    .c-hero {
        background: var(--dark);
        min-height: 520px;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

        .c-hero::before {
            content: '';
            position: absolute;
            top: -200px;
            right: -100px;
            width: 500px;
            height: 900px;
            background: linear-gradient(135deg, rgba(184,150,62,0.06) 0%, transparent 60%);
            transform: rotate(-15deg);
            pointer-events: none;
        }

        .c-hero::after {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(184,150,62,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(184,150,62,0.05) 1px, transparent 1px);
            background-size: 72px 72px;
            pointer-events: none;
        }

    .c-hero-inner {
        position: relative;
        z-index: 2;
        padding: 110px 0 100px;
    }

    .c-hero-tag {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: var(--gold-light);
        margin-bottom: 28px;
    }

        .c-hero-tag::before {
            content: '';
            display: block;
            width: 30px;
            height: 1px;
            background: var(--gold-light);
        }

    .c-hero-h1 {
        font-family: var(--font-serif);
        font-size: clamp(3.2rem, 7vw, 6rem);
        font-weight: 400;
        color: #fff;
        line-height: 1.0;
        letter-spacing: -0.02em;
        margin-bottom: 0;
    }

        .c-hero-h1 em {
            font-style: italic;
            color: var(--gold-light);
        }

    .c-hero-sub {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 300;
        letter-spacing: 0.08em;
        color: var(--muted2);
        line-height: 2;
        max-width: 360px;
        margin-top: 28px;
    }

    .c-hero-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        justify-content: center;
        height: 100%;
        padding: 110px 0;
        gap: 24px;
    }

    .c-hero-vertical {
        writing-mode: vertical-rl;
        text-orientation: mixed;
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: rgba(184,150,62,0.45);
        transform: rotate(180deg);
    }

    .c-hero-vline {
        width: 1px;
        height: 120px;
        background: linear-gradient(180deg, transparent, var(--gold-light), transparent);
        margin-left: auto;
    }

    /* ── SECTION LABELS ─────────────────────────────────── */
    .c-tag {
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: var(--gold);
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

        .c-tag::after {
            content: '';
            display: block;
            width: 40px;
            height: 1px;
            background: var(--gold);
        }

    .c-h2 {
        font-family: var(--font-serif);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 400;
        color: var(--dark);
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-bottom: 0;
    }

        .c-h2 em {
            font-style: italic;
            color: var(--gold);
        }

    .c-h2-light {
        font-family: var(--font-serif);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 400;
        color: #fff;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin-bottom: 0;
    }

        .c-h2-light em {
            font-style: italic;
            color: var(--gold-light);
        }

    .c-p {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 300;
        color: var(--muted);
        line-height: 2;
        letter-spacing: 0.03em;
    }

    /* ── CONTACT CARDS ──────────────────────────────────── */
    .c-cards {
        background: var(--light);
        padding: 90px 0;
    }

    .c-card {
        background: #fff;
        border: 1px solid var(--border-light);
        padding: 36px 28px 32px;
        height: 100%;
        position: relative;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.25,0.46,0.45,0.94);
    }

        .c-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--gold), var(--gold-light));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.4s ease;
        }

        .c-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 60px rgba(0,0,0,0.08), 0 4px 12px rgba(184,150,62,0.1);
            border-color: var(--cream);
        }

            .c-card:hover::after {
                transform: scaleX(1);
            }

    .c-card-num {
        font-family: var(--font-alt);
        font-size: 3rem;
        font-weight: 300;
        color: var(--cream);
        line-height: 1;
        margin-bottom: 16px;
        letter-spacing: -0.03em;
    }

    .c-card-icon {
        width: 44px;
        height: 44px;
        background: var(--dark);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        font-size: 16px;
        transition: background 0.3s;
    }

    .c-card:hover .c-card-icon {
        background: var(--gold);
    }

    .c-card-label {
        font-family: var(--font-sans);
        font-size: 8px;
        font-weight: 600;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: var(--gold);
        margin-bottom: 8px;
        display: block;
    }

    .c-card-title {
        font-family: var(--font-serif);
        font-size: 1.2rem;
        font-weight: 500;
        color: var(--dark);
        margin-bottom: 10px;
        letter-spacing: -0.01em;
    }

    .c-card-val {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 300;
        color: var(--muted);
        line-height: 1.9;
        margin: 0;
        letter-spacing: 0.02em;
    }

    /* ── PROMISE STRIP ──────────────────────────────────── */
    .c-promise {
        background: var(--dark2);
        padding: 90px 0;
        position: relative;
        overflow: hidden;
    }

        .c-promise::before,
        .c-promise::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            height: 1px;
            background: linear-gradient(90deg, transparent 0%, var(--gold) 30%, var(--gold-light) 50%, var(--gold) 70%, transparent 100%);
        }

        .c-promise::before {
            top: 0;
        }

        .c-promise::after {
            bottom: 0;
        }

    .c-promise-big {
        font-family: var(--font-serif);
        font-size: clamp(3.5rem, 8vw, 6.5rem);
        font-weight: 400;
        color: var(--gold);
        line-height: 1;
        letter-spacing: -0.04em;
        opacity: 0.75;
    }

    .c-promise-title {
        font-family: var(--font-serif);
        font-size: 1rem;
        font-weight: 500;
        color: #fff;
        letter-spacing: 0.05em;
        margin-bottom: 10px;
    }

    .c-promise-text {
        font-family: var(--font-sans);
        font-size: 11px;
        font-weight: 300;
        color: var(--muted2);
        line-height: 2;
        letter-spacing: 0.04em;
        margin: 0;
    }

    .c-promise-sep {
        width: 1px;
        background: rgba(184,150,62,0.2);
        align-self: stretch;
        min-height: 100px;
    }

    /* ── FAQ ────────────────────────────────────────────── */
    .c-faq {
        background: var(--light2);
        padding: 90px 0;
    }

    .c-faq-item {
        border-bottom: 1px solid var(--border-light);
    }

    .c-faq-btn {
        width: 100%;
        background: none;
        border: none;
        padding: 24px 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        cursor: pointer;
        text-align: left;
    }

    .c-faq-q {
        font-family: var(--font-serif);
        font-size: 1.05rem;
        font-weight: 400;
        color: var(--dark);
        letter-spacing: -0.01em;
        line-height: 1.3;
        transition: color 0.2s;
    }

    .c-faq-btn:hover .c-faq-q {
        color: var(--gold);
    }

    .c-faq-ico {
        width: 28px;
        height: 28px;
        border: 1px solid var(--border-light);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 14px;
        color: var(--gold);
        font-weight: 300;
        transition: all 0.3s ease;
        font-family: var(--font-sans);
    }

    .c-faq-btn.open .c-faq-ico {
        transform: rotate(45deg);
        background: var(--gold);
        color: #fff;
        border-color: var(--gold);
    }

    .c-faq-a {
        font-family: var(--font-sans);
        font-size: 12px;
        font-weight: 300;
        color: var(--muted);
        line-height: 2;
        letter-spacing: 0.03em;
        padding: 0 0 24px;
        display: none;
        max-width: 580px;
    }

    /* ── LOCATION ───────────────────────────────────────── */
    .c-location {
        background: var(--dark3);
        height: 360px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
    }

        .c-location::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(184,150,62,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(184,150,62,0.04) 1px, transparent 1px);
            background-size: 48px 48px;
        }

        .c-location::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse 60% 60% at 50% 50%, transparent 40%, var(--dark3) 100%);
        }

    .c-location-inner {
        position: relative;
        z-index: 2;
        text-align: center;
    }

    .c-loc-ring {
        width: 80px;
        height: 80px;
        border: 1px solid rgba(184,150,62,0.4);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        position: relative;
        animation: ringPulse 3s ease-in-out infinite;
    }

        .c-loc-ring::before {
            content: '';
            position: absolute;
            inset: -12px;
            border: 1px solid rgba(184,150,62,0.15);
            border-radius: 50%;
        }

    @@keyframes ringPulse {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(184,150,62,0.3);
        }

        50% {
            box-shadow: 0 0 0 16px rgba(184,150,62,0);
        }
    }

    .c-loc-ring span {
        font-size: 26px;
    }

    .c-loc-label {
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: var(--muted2);
        margin-bottom: 8px;
    }

    .c-loc-city {
        font-family: var(--font-serif);
        font-size: 2.4rem;
        font-weight: 400;
        color: var(--gold-light);
        letter-spacing: -0.02em;
        line-height: 1;
    }

    .c-loc-country {
        font-family: var(--font-sans);
        font-size: 10px;
        font-weight: 300;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: var(--muted2);
        margin-top: 6px;
    }

    /* ── SOCIAL ─────────────────────────────────────────── */
    .c-social {
        background: var(--dark);
        padding: 50px 0;
        border-top: 1px solid var(--border-dark);
        text-align: center;
    }

    .c-social-label {
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 5px;
        text-transform: uppercase;
        color: var(--muted2);
        margin-bottom: 28px;
        display: block;
    }

    .c-social-links {
        display: flex;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .c-social-link {
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 500;
        letter-spacing: 3px;
        text-transform: uppercase;
        color: var(--muted2);
        text-decoration: none;
        padding: 11px 24px;
        border: 1px solid rgba(184,150,62,0.2);
        transition: all 0.3s ease;
        display: inline-block;
    }

        .c-social-link:hover {
            color: var(--gold-light);
            border-color: var(--gold);
            background: var(--gold-dim);
        }

    /* ── CTA ────────────────────────────────────────────── */
    .c-cta {
        background: var(--gold);
        padding: 80px 0;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .c-cta::before {
            content: '';
            position: absolute;
            top: -80px;
            right: -80px;
            width: 300px;
            height: 300px;
            border-radius: 50%;
            background: rgba(255,255,255,0.06);
        }

        .c-cta::after {
            content: '';
            position: absolute;
            bottom: -100px;
            left: 20%;
            width: 250px;
            height: 250px;
            border-radius: 50%;
            background: rgba(255,255,255,0.04);
        }

        .c-cta h2 {
            font-family: var(--font-serif);
            font-size: clamp(1.8rem, 4vw, 2.8rem);
            font-weight: 400;
            color: #fff;
            letter-spacing: -0.02em;
            margin-bottom: 10px;
        }

            .c-cta h2 em {
                font-style: italic;
            }

        .c-cta p {
            font-family: var(--font-sans);
            font-size: 12px;
            font-weight: 300;
            color: rgba(255,255,255,0.72);
            letter-spacing: 0.05em;
            margin-bottom: 36px;
        }

    .c-cta-btn-dark {
        display: inline-block;
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #fff;
        background: var(--dark);
        padding: 14px 40px;
        text-decoration: none;
        border: 1px solid var(--dark);
        transition: all 0.3s ease;
        position: relative;
        z-index: 1;
    }

        .c-cta-btn-dark:hover {
            background: transparent;
            color: #fff;
            border-color: rgba(255,255,255,0.6);
        }

    .c-cta-btn-outline {
        display: inline-block;
        font-family: var(--font-sans);
        font-size: 9px;
        font-weight: 600;
        letter-spacing: 4px;
        text-transform: uppercase;
        color: #fff;
        background: transparent;
        padding: 14px 40px;
        text-decoration: none;
        border: 1px solid rgba(255,255,255,0.5);
        transition: all 0.3s ease;
        position: relative;
        z-index: 1;
    }

        .c-cta-btn-outline:hover {
            background: rgba(255,255,255,0.12);
            border-color: #fff;
            color: #fff;
        }

    @@media (max-width: 768px) {
        .c-hero-right {
            display: none;
        }

        .c-promise-sep {
            display: none;
        }

        .c-hero-h1 {
            font-size: 3rem;
        }
    }
</style>

<div class="contact-page">

    <!-- ── HERO ──────────────────────────────────────────────── -->
    <section class="c-hero">
        <div class="container c-hero-inner">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="c-hero-tag">Customer Care</div>
                    <h1 class="c-hero-h1">
                        We're Always<br />
                        <em>Here for You</em>
                    </h1>
                    <p class="c-hero-sub">
                        Our dedicated team is committed to providing you with the finest shopping experience — before, during, and after every purchase.
                    </p>
                </div>
                <div class="col-lg-3 offset-lg-1 d-none d-lg-flex c-hero-right">
                    <div class="c-hero-vline"></div>
                    <span class="c-hero-vertical">Vestra Store — Est. 2020</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ── CONTACT CARDS ──────────────────────────────────────── -->
    <section class="c-cards">
        <div class="container">
            <div class="row align-items-end mb-5">
                <div class="col-lg-5">
                    <div class="c-tag">Connect</div>
                    <h2 class="c-h2">Reach Us<br /><em>Directly</em></h2>
                </div>
                <div class="col-lg-5 offset-lg-2 pt-3">
                    <p class="c-p">Every inquiry is handled with discretion and care. Choose your preferred channel and our team will respond promptly.</p>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-sm-6 col-xl-3">
                    <div class="c-card">
                        <div class="c-card-num">01</div>
                        <div class="c-card-icon">✉️</div>
                        <span class="c-card-label">Email</span>
                        <h4 class="c-card-title">Write to Us</h4>
                        <p class="c-card-val">support@Vestrastore.com<br />returns@Vestrastore.com</p>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="c-card">
                        <div class="c-card-num">02</div>
                        <div class="c-card-icon">📞</div>
                        <span class="c-card-label">Phone</span>
                        <h4 class="c-card-title">Call Us</h4>
                        <p class="c-card-val">+20 100 000 0000<br />+20 100 000 0001</p>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="c-card">
                        <div class="c-card-num">03</div>
                        <div class="c-card-icon">📍</div>
                        <span class="c-card-label">Location</span>
                        <h4 class="c-card-title">Visit Our Store</h4>
                        <p class="c-card-val">Downtown Cairo,<br />Egypt — 11511</p>
                    </div>
                </div>
                <div class="col-sm-6 col-xl-3">
                    <div class="c-card">
                        <div class="c-card-num">04</div>
                        <div class="c-card-icon">🕐</div>
                        <span class="c-card-label">Hours</span>
                        <h4 class="c-card-title">Opening Hours</h4>
                        <p class="c-card-val">Sun – Thu: 9AM – 6PM<br />Fri – Sat: 10AM – 4PM</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ── PROMISE STRIP ───────────────────────────────────────── -->
    <section class="c-promise">
        <div class="container">
            <div class="row justify-content-center text-center g-4 align-items-center">
                <div class="col-md-3">
                    <div class="c-promise-big">24h</div>
                    <h5 class="c-promise-title">Response Guarantee</h5>
                    <p class="c-promise-text">Every message answered within 24 hours on all business days, without exception.</p>
                </div>
                <div class="col-auto d-none d-md-flex c-promise-sep"></div>
                <div class="col-md-3">
                    <div class="c-promise-big">7/7</div>
                    <h5 class="c-promise-title">Always Available</h5>
                    <p class="c-promise-text">Our digital support channels operate seven days a week for your convenience.</p>
                </div>
                <div class="col-auto d-none d-md-flex c-promise-sep"></div>
                <div class="col-md-3">
                    <div class="c-promise-big">30d</div>
                    <h5 class="c-promise-title">Free Returns</h5>
                    <p class="c-promise-text">Hassle-free returns accepted within 30 days of purchase — no questions asked.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ── FAQ ─────────────────────────────────────────────────── -->
    <section class="c-faq">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 mb-5 mb-lg-0">
                    <div class="c-tag">FAQ</div>
                    <h2 class="c-h2" style="margin-bottom:20px;">Common<br /><em>Questions</em></h2>
                    <div style="width:28px;height:1px;background:var(--gold);margin-bottom:20px;"></div>
                    <p class="c-p">Can't find your answer? Our support team is just an email away and always happy to help.</p>
                </div>
                <div class="col-lg-7 offset-lg-1">

                    <div class="c-faq-item">
                        <button class="c-faq-btn" onclick="toggleFaq(this)">
                            <span class="c-faq-q">How can I track my order?</span>
                            <span class="c-faq-ico">+</span>
                        </button>
                        <p class="c-faq-a">Once your order ships, you will receive a confirmation email with a tracking number. Use this number on our website or the courier's portal to follow your shipment in real time.</p>
                    </div>

                    <div class="c-faq-item">
                        <button class="c-faq-btn" onclick="toggleFaq(this)">
                            <span class="c-faq-q">What is your return policy?</span>
                            <span class="c-faq-ico">+</span>
                        </button>
                        <p class="c-faq-a">We accept returns within 30 days of purchase. Items must be unworn, unwashed, and in their original packaging with all tags attached. Contact returns@Vestrastore.com to begin.</p>
                    </div>

                    <div class="c-faq-item">
                        <button class="c-faq-btn" onclick="toggleFaq(this)">
                            <span class="c-faq-q">Do you offer international shipping?</span>
