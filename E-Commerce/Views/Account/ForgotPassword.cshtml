@model E_Commerce.ViewModels.Account.ForgotPasswordVM
@{
    ViewData["Title"] = "Forgot Password";
}

<section class="auth-section">
    <div class="container position-relative" style="z-index:1;">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5 col-xl-4">
                <div class="auth-card">
                    <span class="auth-logo">Vestra</span>
                    <span class="auth-eyebrow">Account Recovery</span>
                    <h2 class="auth-title">Forgot Password?</h2>
                    <p class="auth-subtitle">Enter your email and we'll send you a reset link.</p>

                    @if (TempData["UnverifiedEmail"] != null)
                    {
                        <div class="alert" style="background:rgba(176,154,126,0.12);border:1px solid var(--gold);border-radius:4px;padding:12px 16px;font-size:0.83rem;color:var(--ink);margin-bottom:1.2rem;">
                            <strong>Email verification required.</strong> Please verify your email before resetting your password.
                        </div>
                        <form asp-action="ResendVerificationEmail" asp-controller="Account" method="post" class="mb-3">
                            <input type="hidden" name="email" value="@TempData["UnverifiedEmail"]" />
                            <button type="submit" class="btn-auth-outline">Resend Verification Email</button>
                        </form>
                    }

                    <form asp-action="ForgotPassword" method="post" class="auth-form">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:0.83rem;"></div>

                        <div class="mb-4">
                            <label asp-for="Email">Email Address</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="your@email.com" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>

                        <button type="submit" class="btn-auth-primary">Send Reset Link</button>
                    </form>

                    <p class="auth-footer-note">
                        Remember your password?
                        <a asp-action="Login" asp-controller="Account" class="auth-link">Back to Sign In</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
