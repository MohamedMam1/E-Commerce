@model E_Commerce.ViewModels.Account.ForgotPasswordVM

@{
    ViewData["Title"] = "Forgot Password";
}

<section class="vh-100" style="background-color: #508bfc;">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card shadow-2-strong" style="border-radius: 1rem;">
                    <div class="card-body p-5 text-center">
                        <h3 class="mb-2">Forgot Password?</h3>
                        <p class="text-muted small mb-4">Enter your email address and we'll send you a link to reset your password</p>

                        <form asp-action="ForgotPassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>

                            <!-- Email Verification Warning -->
                            @if (TempData["UnverifiedEmail"] != null)
                            {
                                <div class="alert alert-warning" role="alert">
                                    <strong>Email verification required!</strong> Please verify your email before resetting password.
                                </div>

                                <form asp-action="ResendVerificationEmail" asp-controller="Account" method="post" class="mb-3">
                                    <input type="hidden" name="email" value="@TempData["UnverifiedEmail"]" />
                                    <button type="submit" class="btn btn-warning w-100 mb-3">
                                        Resend Verification Email
                                    </button>
                                </form>
                            }

                            <!-- Email -->
                            <div class="form-outline mb-4">
                                <input asp-for="Email" type="email" id="Email" class="form-control form-control-lg" placeholder="Enter your email" />
                                <label class="form-label" for="Email">Email Address</label>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary btn-lg btn-block mb-4">
                                Send Reset Link
                            </button>

                            <hr class="my-4">

                            <!-- Back to Login -->
                            <p class="fs-6 mb-0">
                                Remember your password?
                                <a asp-action="Login" asp-controller="Account" class="text-decoration-none fw-bold">Back to Login</a>
                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
