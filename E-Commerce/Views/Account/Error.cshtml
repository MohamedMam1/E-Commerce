@{
    ViewData["Title"] = "Verification Failed";
}

<section class="auth-section">
    <div class="container position-relative" style="z-index:1;">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5 col-xl-4">
                <div class="auth-card text-center">
                    <div class="auth-icon-circle danger mx-auto mb-3">
                        <i class="bi bi-exclamation-circle fs-3"></i>
                    </div>
                    <span class="auth-eyebrow">Oops</span>
                    <h2 class="auth-title">Verification Failed</h2>
                    <p class="auth-subtitle">
                        We couldn't verify your email. The link may have expired or is invalid.
                    </p>
                    <a asp-action="Login" asp-controller="Account" class="btn-auth-primary mt-2">Back to Sign In</a>
                    <a asp-action="Register" asp-controller="Account" class="btn-auth-outline">Register Again</a>
                </div>
            </div>
        </div>
    </div>
</section>
