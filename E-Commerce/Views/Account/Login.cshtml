@model E_Commerce.ViewModels.Account.LoginUserVM

@{
    ViewData["Title"] = "Login";
}

<section class="vh-100" style="background-color: #508bfc;">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card shadow-2-strong" style="border-radius: 1rem;">
                    <div class="card-body p-5 text-center">

                        <h3 class="mb-5">Login</h3>

                        <!-- Email Verification Warning (outside login form to avoid nested forms) -->
                        @if (TempData["UnverifiedEmail"] != null)
                        {
                            <div class="alert alert-warning" role="alert">
                                <strong>Email verification required!</strong> Please verify your email to proceed.
                            </div>

                            <form asp-action="ResendVerificationEmail" asp-controller="Account" method="post" class="mb-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="email" value="@TempData["UnverifiedEmail"]" />
                                <button type="submit" class="btn btn-warning w-100 mb-3">
                                    Resend Verification Email
                                </button>
                            </form>
                        }

                        <!-- Login Form -->
                        <form asp-action="Login" method="post">
                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly" class="text-danger mb-4 text-start"></div>

                            <!-- Email -->
                            <div class="form-outline mb-1">
                                <input asp-for="Email" type="email" id="Email" class="form-control form-control-lg" />
                                <label class="form-label" for="Email">Email</label>
                            </div>
                            <span asp-validation-for="Email" class="text-danger small d-block text-start mb-3"></span>

                            <!-- Password -->
                            <div class="form-outline mb-1">
                                <input asp-for="Password" type="password" id="Password" class="form-control form-control-lg" />
                                <label class="form-label" for="Password">Password</label>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small d-block text-start mb-3"></span>

                            <!-- Forgot Password Link -->
                            <div class="text-end mb-3">
                                <a asp-action="ForgotPassword" asp-controller="Account" class="text-decoration-none fw-bold" style="color: #508bfc; font-size: 0.9rem;">
                                    Forgot password?
                                </a>
                            </div>

                            <!-- Remember Me -->
                            <div class="form-check d-flex justify-content-start mb-4">
                                <input class="form-check-input" asp-for="RememberMe" type="checkbox" id="RememberMe" />
                                <label class="form-check-label" for="RememberMe"> @Html.DisplayNameFor(m => m.RememberMe)</label>
                            </div>

                            <!-- Login Button -->
                            <button type="submit" class="btn btn-primary btn-lg btn-block mb-4">Login</button>

                        </form>
                        <!-- Form End -->

                        <div class="mt-3">
                            <p class="fs-6 mb-0">
                                Don't have an account?
                                <a asp-action="Register" asp-controller="Account" class="text-decoration-none fw-bold">Register here</a>
                            </p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
