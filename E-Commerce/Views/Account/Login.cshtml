@model E_Commerce.ViewModels.Account.LoginUserVM
@{
    ViewData["Title"] = "Login";
}

<section class="auth-section">
    <div class="container position-relative" style="z-index:1;">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5 col-xl-4">
                <div class="auth-card">
                    <span class="auth-logo">Vestra</span>
                    <span class="auth-eyebrow">Welcome Back</span>
                    <h2 class="auth-title">Sign In</h2>
                    <p class="auth-subtitle">Access your account, orders, and wishlist.</p>

                    @if (TempData["UnverifiedEmail"] != null)
                    {
                        <div class="alert" style="background:rgba(176,154,126,0.12);border:1px solid var(--gold);border-radius:4px;padding:12px 16px;font-size:0.83rem;color:var(--ink);margin-bottom:1.2rem;">
                            <strong>Email verification required.</strong> Please verify your email to proceed.
                        </div>
                        <form asp-action="ResendVerificationEmail" asp-controller="Account" method="post" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="@TempData["UnverifiedEmail"]" />
                            <button type="submit" class="btn-auth-outline">Resend Verification Email</button>
                        </form>
                    }

                    <form asp-action="Login" method="post" class="auth-form">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:0.83rem;"></div>

                        <div class="mb-3">
                            <label asp-for="Email">Email Address</label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password">Password</label>
                            <input asp-for="Password" class="form-control" type="password" />
                            <span asp-validation-for="Password" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="RememberMe" type="checkbox" id="RememberMe" />
                                <label class="form-check-label" for="RememberMe" style="font-size:0.82rem;color:var(--stone);text-transform:none;letter-spacing:0;">
                                    @Html.DisplayNameFor(m => m.RememberMe)
                                </label>
                            </div>
                            <a asp-action="ForgotPassword" asp-controller="Account" class="auth-link" style="font-size:0.8rem;">Forgot password?</a>
                        </div>

                        <button type="submit" class="btn-auth-primary">Sign In</button>
                    </form>

                    <p class="auth-footer-note">
                        Don't have an account?
                        <a asp-action="Register" asp-controller="Account" class="auth-link">Register here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
