@{
}
@{
    ViewData["Title"] = "Email Sent";
}
<section class="vh-100" style="background-color: #508bfc;">
    <div class="container py-5 h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="card shadow-2-strong" style="border-radius: 1rem;">
                    <div class="card-body p-5 text-center">
                        
                        @if (TempData["Message"] != null)
                        {
                            <div class="alert alert-success" role="alert">
                                @TempData["Message"]
                            </div>
                        }

                        <div class="mb-4">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                                 style="width:72px;height:72px;background-color:#e8f0fe;">
                                <i class="fas fa-envelope fa-2x" style="color:#508bfc;"></i>
                            </div>
                        </div>
                        <h3 class="mb-2">Email Sent Successfully</h3>
                        <p class="text-muted mb-1">Check your email to verify your account or reset your password.</p>
                        <p class="text-muted small mb-4">
                            Look for a link in the email. If you don't see it, check your spam folder.
                        </p>
                        <hr class="my-4">
                        <div class="mt-3">
                            <a asp-action="Login" asp-controller="Account"
                               class="btn btn-primary">
                                Back to Login
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
