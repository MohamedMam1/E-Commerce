@{
    ViewData["Title"] = "Email Sent";
}

<section class="auth-section">
    <div class="container position-relative" style="z-index:1;">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5 col-xl-4">
                <div class="auth-card text-center">
                    @if (TempData["Message"] != null)
                    {
                        <div style="background:rgba(46,125,80,0.1);border:1px solid rgba(46,125,80,0.3);border-radius:4px;padding:12px 16px;font-size:0.83rem;color:#2e7d50;margin-bottom:1.5rem;">
                            @TempData["Message"]
                        </div>
                    }
                    <div class="auth-icon-circle gold mx-auto mb-3">
                        <i class="bi bi-envelope fs-3"></i>
                    </div>
                    <span class="auth-eyebrow">Check Your Inbox</span>
                    <h2 class="auth-title">Email Sent</h2>
                    <p class="auth-subtitle">
                        Check your email for a verification or reset link.<br>
                        Can't find it? Check your spam folder.
                    </p>
                    <a asp-action="Login" asp-controller="Account" class="btn-auth-primary mt-2">Back to Sign In</a>
                </div>
            </div>
        </div>
    </div>
</section>
