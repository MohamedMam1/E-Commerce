@{
    ViewData["Title"] = "Email Verified";
}

<section class="auth-section">
    <div class="container position-relative" style="z-index:1;">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-5 col-xl-4">
                <div class="auth-card text-center">
                    <div class="auth-icon-circle success mx-auto mb-3">
                        <i class="bi bi-check-lg fs-3"></i>
                    </div>
                    <span class="auth-eyebrow">All Done</span>
                    <h2 class="auth-title">Email Verified!</h2>
                    <p class="auth-subtitle">
                        Your email has been successfully confirmed.<br>
                        Redirecting in <span id="countdown">2</span> seconds…
                    </p>
                    <a asp-action="Login" asp-controller="Account" class="btn-auth-primary mt-2">Go to Sign In</a>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        var s = 2, el = document.getElementById('countdown');
        var iv = setInterval(function () {
            s--; if (el) el.textContent = s;
            if (s <= 0) { clearInterval(iv); window.location.href = '@Url.Action("Login", "Account")'; }
        }, 1000);
    </script>
}
