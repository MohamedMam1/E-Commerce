@using E_Commerce.ViewModels.Account
@model RegisterUserVM
@{
    ViewData["Title"] = "Register";
}

<section class="auth-section">
    <div class="container position-relative" style="z-index:1;">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6 col-xl-5">
                <div class="auth-card">
                    <span class="auth-logo">Vestra</span>
                    <span class="auth-eyebrow">Create Account</span>
                    <h2 class="auth-title">Register</h2>
                    <p class="auth-subtitle">Join us and start shopping with style.</p>

                    <form asp-action="Register" asp-controller="Account" method="post" class="auth-form">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:0.83rem;"></div>

                        <div class="mb-3">
                            <label asp-for="FullName">Full Name</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Email">Email Address</label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password">Password</label>
                                <input asp-for="Password" class="form-control" />
                                <span asp-validation-for="Password" class="text-danger" style="font-size:0.75rem;"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword">Confirm Password</label>
                                <input asp-for="ConfirmPassword" class="form-control" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size:0.75rem;"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Phone">Phone Number</label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Address">Address</label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="City">City</label>
                                <input asp-for="City" class="form-control" />
                                <span asp-validation-for="City" class="text-danger" style="font-size:0.75rem;"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PostalCode">Postal Code</label>
                                <input asp-for="PostalCode" class="form-control" />
                                <span asp-validation-for="PostalCode" class="text-danger" style="font-size:0.75rem;"></span>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Country">Country</label>
                            <input asp-for="Country" class="form-control" />
                            <span asp-validation-for="Country" class="text-danger" style="font-size:0.75rem;"></span>
                        </div>

                        <button type="submit" class="btn-auth-primary">Create Account</button>
                    </form>

                    <p class="auth-footer-note">
                        Already have an account?
                        <a asp-controller="Account" asp-action="Login" class="auth-link">Sign in here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
