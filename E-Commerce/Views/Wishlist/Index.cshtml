@model E_Commerce.ViewModels.Wishlist.WishlistVM

@{
    ViewData["Title"] = "My Wishlist";
}

<div class="wishlist-page py-5">
    <div class="container">
        <div class="wishlist-header">
            <div class="breadcrumb-trail">
                <a href="/">Home</a>
                <span style="margin: 0 0.5rem;">&#x2192;</span>
                <span>My Wishlist</span>
            </div>
            <h1>My Wishlist</h1>
            @if (Model.Items.Any())
            {
                <p class="item-count">@Model.Items.Count() item@(Model.Items.Count() != 1 ? "s" : "") saved</p>
            }
        </div>

        <div class="wishlist-table-wrap" style="overflow-x:auto;">
            <table class="wishlist-table">
                @if (Model.Items.Any())
                {
                    <thead>
                        <tr>
                            <th colspan="2">Product</th>
                            <th class="col-price">Price</th>
                            <th class="col-status">Status</th>
                            <th class="col-action">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="wishlist-row">
                                <td style="width: 96px; padding-right: 0;">
                                    <div class="product-img-wrap">
                                        <img src="@item.ImageUrl" alt="@item.ProductName">
                                    </div>
                                </td>
                                <td><span class="product-name">@item.ProductName</span></td>
                                <td class="price-cell">$@item.Price.ToString("0.00")</td>
                                <td class="status-cell">
                                    @if (item.IsAvailable)
                                    {
                                        <span class="stock-badge in-stock">In Stock</span>
                                    }
                                    else
                                    {
                                        <span class="stock-badge out-of-stock">Out of Stock</span>
                                    }
                                </td>
                                <td class="action-cell">
                                    <div class="action-group">
                                        @if (item.IsAvailable)
                                        {
                                            <a href="@Url.Action("Index", "ProductDetail", new { id = item.ProductId })" class="btn-add-cart">
                                                <svg viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                                                <span>View</span>
                                            </a>
                                        }
                                        <form asp-action="RemoveFromWishlist" asp-controller="Wishlist" method="post" class="d-inline">
                                            <input type="hidden" name="productId" value="@item.ProductId" />
                                            <button type="submit" class="remove-btn" aria-label="Remove">
                                                <svg class="remove-icon" viewBox="0 0 24 24">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path d="M19 6l-1 14H6L5 6"></path>
                                                    <path d="M10 11v6M14 11v6"></path>
                                                    <path d="M9 6V4h6v2"></path>
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                }
                else
                {
                    <tbody>
                        <tr>
                            <td colspan="5">
                                <div class="empty-wishlist">
                                    <svg class="empty-wishlist-icon" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5">
                                        <path d="M32 54s-26-16-26-32a14 14 0 0 1 26-7 14 14 0 0 1 26 7c0 16-26 32-26 32z" />
                                    </svg>
                                    <h3>Your wishlist is empty</h3>
                                    <p>Save items you love and come back to them later.</p>
                                    <a href="/" class="btn-continue">Explore Products</a>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                }
            </table>
        </div>
    </div>
</div>
