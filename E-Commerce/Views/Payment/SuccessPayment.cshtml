@model E_Commerce.ViewModels.PaymentSuccessVM
@{
    ViewData["Title"] = "Payment Successful";
}

<div class="payment-result-page">
    <div class="container">
        <div class="payment-result-card mx-auto">
            <div class="auth-icon-circle success mx-auto mb-3">
                <i class="bi bi-check-lg fs-3"></i>
            </div>
            <span class="eyebrow d-block mb-2">Thank You</span>
            <h2 class="payment-result-title">Payment Successful</h2>
            <p class="payment-result-sub">Your order has been confirmed. A receipt has been sent to your email.</p>

            <div style="background:var(--parchment);border-radius:4px;padding:1rem 1.2rem;margin-bottom:2rem;">
                <div class="payment-detail-row">
                    <span class="lbl">Amount charged</span>
                    <span class="val" style="font-family:var(--ff-serif);font-size:1.1rem;">@Model.TotalAmount LE</span>
                </div>
                <div class="payment-detail-row">
                    <span class="lbl">Charge ID</span>
                    <span class="val" style="font-size:0.72rem;font-family:monospace;">@Model.ChargeId</span>
                </div>
            </div>

            <div class="d-grid gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn-auth-primary">Continue Shopping</a>
                <a asp-controller="UserDashboard" asp-action="Orders" class="btn-auth-outline">View My Orders</a>
            </div>
        </div>
    </div>
</div>
