@model E_Commerce.ViewModels.CheckoutVM
@{
    ViewData["Title"] = "Checkout";
}

<div class="container" style="max-width:600px; margin:50px auto;">
    <h2>🛒 Order Summary</h2>

    <table class="table table-bordered">
        <thead>
            <tr><th>Product</th><th>Size</th><th>Color</th><th>Qty</th><th>Price</th><th>Subtotal</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.CartItems)
            {
                <tr>
                    <td>@item.ProductName</td>
                    <td>@item.Size</td>
                    <td>@item.Color</td>
                    <td>@item.Quantity</td>
                    <td>@item.Price LE</td>
                    <td>@item.Subtotal LE</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5"><strong>Total</strong></td>
                <td><strong>@Model.TotalAmount LE</strong></td>
            </tr>
        </tfoot>
    </table>

    <hr />
    <h4>💳 Payment Details</h4>

    <form id="payment-form" asp-controller="Payment" asp-action="ProcessPayment" method="post">
        <input type="hidden" name="totalAmount" value="@Model.TotalAmount" />
        <input type="hidden" id="stripeToken" name="stripeToken" />

        <div class="form-group">
            <label>Card Number</label>
            <div id="card-number-element"
                 style="border:1px solid #ccc; padding:12px; border-radius:5px;">
            </div>
        </div>

        <div class="form-row" style="display:flex; gap:15px; margin-top:15px;">
            <div class="form-group" style="flex:1;">
                <label>Expiry Date</label>
                <div id="card-expiry-element"
                     style="border:1px solid #ccc; padding:12px; border-radius:5px;">
                </div>
            </div>
            <div class="form-group" style="flex:1;">
                <label>CVC</label>
                <div id="card-cvc-element"
                     style="border:1px solid #ccc; padding:12px; border-radius:5px;">
                </div>
            </div>
        </div>

        <div class="form-group" style="margin-top:15px;">
            <label>ZIP Code</label>
            <input type="text" id="zip" name="zip" class="form-control"
                   placeholder="12345" maxlength="5" />
        </div>

        <div id="card-errors" style="color:red; margin:10px 0;"></div>

        <button type="submit" class="btn btn-success btn-lg" style="margin-top:15px; width:100%;">
            Pay @Model.TotalAmount LE
        </button>
    </form>
</div>

@section Scripts {
    <script src="https://js.stripe.com/v3/"></script>
    <script>
        var stripe = Stripe('@Model.StripePublishableKey');
        var elements = stripe.elements();

        var cardNumber = elements.create('cardNumber');
        var cardExpiry = elements.create('cardExpiry');
        var cardCvc = elements.create('cardCvc');

        cardNumber.mount('#card-number-element');
        cardExpiry.mount('#card-expiry-element');
        cardCvc.mount('#card-cvc-element');

        [cardNumber, cardExpiry, cardCvc].forEach(function(el) {
            el.addEventListener('change', function(e) {
                document.getElementById('card-errors').textContent =
                    e.error ? e.error.message : '';
            });
        });

        document.getElementById('payment-form').addEventListener('submit', function(e) {
            e.preventDefault();

            stripe.createToken(cardNumber, {
                address_zip: document.getElementById('zip').value
            }).then(function(result) {
                if (result.error) {
                    document.getElementById('card-errors').textContent = result.error.message;
                } else {
                    document.getElementById('stripeToken').value = result.token.id;
                    document.getElementById('payment-form').submit();
                }
            });
        });
    </script>
}