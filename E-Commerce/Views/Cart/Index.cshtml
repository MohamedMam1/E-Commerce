@model E_Commerce.ViewModels.Cart.CartVM

@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="cart-page py-5">
    <div class="container">
        <div class="cart-header">
            <div class="breadcrumb-trail">
                <a href="/">Home</a>
                <span style="margin: 0 0.5rem;">&#x2192;</span>
                <span>Shopping Cart</span>
            </div>
            <h1>Your Cart</h1>
            @if (Model.Items.Any())
            {
                <p class="item-count">@Model.Items.Count() item@(Model.Items.Count() != 1 ? "s" : "")</p>
            }
        </div>

        <div class="row">
            <!-- Cart Items -->
            <div class="col-lg-8 mb-5">
                <div class="cart-table-wrap" style="overflow-x:auto;">
                    <table class="cart-table">
                        @if (Model.Items.Any())
                        {
                            <thead>
                                <tr>
                                    <th colspan="2">Product</th>
                                    <th class="col-price">Price</th>
                                    <th class="col-variant">Variant</th>
                                    <th class="col-qty">Quantity</th>
                                    <th class="col-total">Total</th>
                                    <th class="col-remove"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr class="cart-row">
                                        <td style="width: 96px; padding-right: 0;">
                                            <div class="product-img-wrap">
                                                <img src="@item.ImageUrl" alt="@item.ProductName">
                                            </div>
                                        </td>
                                        <td>
                                            <span class="product-name">@item.ProductName</span>
                                        </td>
                                        <td class="price-cell">$@item.Price.ToString("0.00")</td>
                                        <td class="price-cell" style="text-align:left;font-size:0.78rem;color:var(--stone);">
                                            @item.Size / @item.Color
                                        </td>
                                        <td class="qty-cell">
                                            <div class="qty-control">
                                                <button type="button" class="qty-btn" onclick="updateQuantity(@item.CartItemId, @(item.Quantity - 1), @item.MaxQuantity, @item.Quantity)" aria-label="Decrease">&#x2212;</button>
                                                <input class="qty-input" type="number" value="@item.Quantity" readonly title="Max @item.MaxQuantity in stock">
                                                <button type="button" class="qty-btn" onclick="updateQuantity(@item.CartItemId, @(item.Quantity + 1), @item.MaxQuantity, @item.Quantity)" aria-label="Increase">&#x2B;</button>
                                            </div>
                                            <div style="font-size:0.65rem;color:var(--stone);margin-top:4px;text-align:center;">Max @item.MaxQuantity</div>
                                        </td>
                                        <td class="total-cell">$@item.Subtotal.ToString("0.00")</td>
                                        <td class="remove-cell">
                                            <form asp-action="RemoveFromCart" asp-controller="Cart" method="post" class="d-inline">
                                                <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                                <button type="submit" class="remove-btn" aria-label="Remove item">
                                                    <svg class="remove-icon" viewBox="0 0 24 24">
                                                        <polyline points="3 6 5 6 21 6"></polyline>
                                                        <path d="M19 6l-1 14H6L5 6"></path>
                                                        <path d="M10 11v6M14 11v6"></path>
                                                        <path d="M9 6V4h6v2"></path>
                                                    </svg>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                        else
                        {
                            <tbody>
                                <tr>
                                    <td colspan="7">
                                        <div class="empty-cart">
                                            <svg class="empty-cart-icon" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5">
                                                <path d="M8 8h5l6 32h30l4-22H18" />
                                                <circle cx="26" cy="52" r="3" />
                                                <circle cx="42" cy="52" r="3" />
                                            </svg>
                                            <h3>Your cart is empty</h3>
                                            <p>Looks like you haven't added anything yet.</p>
                                            <a href="/" class="btn-continue">Continue Shopping</a>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        }
                    </table>
                </div>

                @if (Model.Items.Any())
                {
                    <div class="cart-actions">
                        <form asp-action="ClearCart" asp-controller="Cart" method="post">
                            <button type="submit" class="btn-clear">Clear Cart</button>
                        </form>
                    </div>
                }
            </div>

            <!-- Order Summary -->
            @if (Model.Items.Any())
            {
                <div class="col-lg-4">
                    <div class="summary-panel">
                        <h2>Order Summary</h2>
                        <div class="summary-line">
                            <span class="label">Subtotal</span>
                            <span class="value">$@Model.TotalPrice.ToString("0.00")</span>
                        </div>
                        <div class="summary-total">
                            <span class="label">Total</span>
                            <span class="value">$@Model.TotalPrice.ToString("0.00")</span>
                        </div>
                        <a href="/Payment/Checkout" class="btn-checkout">Proceed to Checkout &rarr;</a>
                        <div class="secure-note">
                            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5">
                                <rect x="3" y="11" width="18" height="11" rx="2" />
                                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            </svg>
                            Secure checkout
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var cartQtyRequestInFlight = false;
        function updateQuantity(cartItemId, newQuantity, maxQty, currentQty) {
            if (newQuantity < 0 || cartQtyRequestInFlight || newQuantity === currentQty) return;
            if (newQuantity > maxQty) { window.alert("Only " + maxQty + " available in stock."); return; }
            cartQtyRequestInFlight = true;
            $.ajax({
                url: '/Cart/UpdateQuantity', type: 'POST', dataType: 'json',
                data: { cartItemId: cartItemId, quantity: newQuantity },
                success: function(r) { if (r && r.success) location.reload(); else window.alert(r && r.message ? r.message : "Try again."); },
                error: function() { window.alert("Could not reach the server."); },
                complete: function() { cartQtyRequestInFlight = false; }
            });
        }
    </script>
}
