                    </div>
                    <div class="col-md-4">
                        <label class="form-label-custom">SKU Code *</label>
                        <input type="text" class="form-control-custom" placeholder="e.g. SKU-40921" />
                    </div>
                </div>
                <!-- Row 2 -->
                <div class="row g-3 mb-3">
