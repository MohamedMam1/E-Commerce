                            <option>Electronics</option>
                            <option>Clothing</option>
                            <option>Footwear</option>
                            <option>Accessories</option>
                            <option>Wearables</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label-custom">Price *</label>
                        <input type="number" class="form-control-custom" placeholder="0.00" min="0" step="0.01" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label-custom">Stock Quantity *</label>
                        <input type="number" class="form-control-custom" placeholder="0" min="0" />
                    </div>
                </div>
                <!-- Row 3 -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label-custom">Brand</label>
                        <input type="text" class="form-control-custom" placeholder="Brand name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label-custom">Discount (%)</label>
                        <input type="number" class="form-control-custom" placeholder="0" min="0" max="100" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label-custom">Status</label>
                        <select class="form-control-custom form-select-custom">
                            <option>Active</option>
                            <option>Draft</option>
                            <option>Archived</option>
                        </select>
                    </div>
                </div>
                <!-- Row 4 -->
                <div class="mb-3">
                    <label class="form-label-custom">Description</label>
                    <textarea class="form-control-custom" rows="3" placeholder="Short product description…" style="resize:vertical"></textarea>
                </div>
                <!-- Row 5: Image Upload -->
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label-custom">Product Images</label>
                        <div class="upload-zone">
                            <i class="bi bi-cloud-upload-fill"></i>
                            <span>Drag & drop images here, or <u>browse</u></span>
                            <div style="font-size:11px;margin-top:4px;color:var(--text-light)">PNG, JPG up to 5MB each</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label-custom">Tags</label>
                        <input type="text" class="form-control-custom" placeholder="wireless, audio, noise-cancelling…" />
                        <div style="font-size:11.5px;color:var(--text-muted);margin-top:5px">Separate tags with commas</div>
                        <label class="form-label-custom mt-3">Weight (kg)</label>
                        <input type="number" class="form-control-custom" placeholder="0.00" step="0.01" />
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="font-family:var(--font);font-size:13px;font-weight:600;border-radius:9px;padding:8px 18px">
                    Cancel
                </button>
                <div class="d-flex gap-2">
                    <button type="button" style="background:#f8fafc;color:var(--text-muted);border:1.5px solid var(--border);border-radius:9px;padding:8px 16px;font-size:13px;font-weight:600;font-family:var(--font);cursor:pointer">
                        Save as Draft
                    </button>
                    <button type="button" class="btn-primary-custom">
                        <i class="bi bi-plus-circle-fill"></i> Publish Product
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap 5 JS -->
